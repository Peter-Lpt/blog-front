---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tools = (await getCollection('tools', ({ data }) => !data.draft))
  .sort((a, b) => b.data.addedDate.getTime() - a.data.addedDate.getTime());

// 分类聚合
const categories = [...new Set(tools.map((t) => t.data.category))];
const categoryCounts: Record<string, number> = {};
tools.forEach((t) => {
  categoryCounts[t.data.category] = (categoryCounts[t.data.category] || 0) + 1;
});
---

<BaseLayout title="工具箱" description="我用过的工具记录">
  <section class="tools-page">
    <header class="page-header">
      <h1>🛠️ 工具箱</h1>
      <p class="page-desc">我正在用 / 用过的工具记录，共 {tools.length} 个</p>
    </header>

    {tools.length === 0 ? (
      <div class="empty">
        <p>暂无工具记录。</p>
        <p>工具清单正在整理中，欢迎稍后再来看看。</p>
      </div>
    ) : (
      <>
        <div class="category-filter" id="filter">
          <button class="cat-btn active" data-cat="all">全部 ({tools.length})</button>
          {categories.map((cat) => (
            <button class="cat-btn" data-cat={cat}>{cat} ({categoryCounts[cat]})</button>
          ))}
        </div>

        <div class="tool-grid">
          {tools.map((tool) => {
            const slug = tool.id.replace(/\.md$/, '');
            const { name, url, category, icon, rating, cost, platform } = tool.data;
            return (
              <article class="tool-card" data-category={category}>
                <a href={`/tools/${slug}/`} class="tool-link">
                  <div class="tool-icon">{icon || '🔧'}</div>
                  <h3 class="tool-name">{name}</h3>
                  <p class="tool-cat">{category}</p>
                  {rating !== undefined && rating > 0 && (
                    <div class="tool-rating">{'★'.repeat(rating)}{'☆'.repeat(5 - rating)}</div>
                  )}
                  <div class="tool-meta">
                    {cost && <span class="meta-tag">{cost}</span>}
                    {platform && platform.length > 0 && <span class="meta-tag">{platform.join('/')}</span>}
                  </div>
                </a>
                <a href={url} target="_blank" rel="noopener noreferrer" class="visit-btn">访问 ↗</a>
              </article>
            );
          })}
        </div>
      </>
    )}
  </section>
</BaseLayout>

<script>
  // 分类筛选交互（纯客户端，无需 Vue 岛）
  const buttons = document.querySelectorAll('.cat-btn');
  const cards = document.querySelectorAll<HTMLElement>('.tool-card');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat');
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      cards.forEach((card) => {
        const show = cat === 'all' || card.getAttribute('data-category') === cat;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>

<style>
  .tools-page { padding: 40px 0; }
  .page-header { margin-bottom: 24px; }
  .page-header h1 { font-size: 28px; margin: 0 0 8px; color: var(--color-text); }
  .page-desc { color: var(--color-text-muted); font-size: 14px; margin: 0; }
  .category-filter {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .cat-btn {
    padding: 6px 14px;
    border: 1px solid var(--color-fog);
    border-radius: 16px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: 13px;
    transition: all 0.2s;
  }
  .cat-btn:hover { border-color: var(--color-signal); color: var(--color-signal); }
  .cat-btn.active {
    background: var(--color-signal);
    color: #fff;
    border-color: var(--color-signal);
  }
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }
  .tool-card {
    background: var(--color-surface);
    border: var(--card-border);
    border-radius: var(--radius-lg);
    padding: 18px;
    transition: all 0.3s;
    position: relative;
  }
  .tool-card:hover {
    box-shadow: var(--shadow-soft);
    border-color: var(--color-signal);
    transform: translateY(-2px);
  }
  .tool-link { color: inherit; display: block; }
  .tool-icon { font-size: 28px; margin-bottom: 8px; }
  .tool-name { font-size: 16px; font-weight: 600; margin: 0 0 4px; color: var(--color-text); }
  .tool-cat { font-size: 12px; color: var(--color-signal); margin: 0 0 6px; }
  .tool-rating { font-size: 12px; color: #f5a623; margin-bottom: 6px; }
  .tool-meta { display: flex; gap: 6px; flex-wrap: wrap; }
  .meta-tag {
    font-size: 11px;
    color: var(--color-text-muted);
    background: var(--glass-bg);
    padding: 2px 8px;
    border-radius: 8px;
  }
  .visit-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 11px;
    color: var(--color-text-muted);
    padding: 3px 8px;
    border-radius: 8px;
    background: var(--glass-bg);
  }
  .visit-btn:hover { color: var(--color-signal); }
  .empty { text-align: center; padding: 60px 20px; color: var(--color-text-muted); }
</style>
