---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LikeButton from '@/components/islands/LikeButton.vue';
import CommentSection from '@/components/islands/CommentSection.vue';
import Sidebar from '@/components/Sidebar.astro';
import { formatDate, getAllPosts, getSlug, resolveCategory, resolveTags } from '@/lib/posts';
import '@/styles/markdown.css';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: getSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const slug = getSlug(post);
const { title, pubDate, updatedDate, description, coverImage } = post.data;
const tags = resolveTags(post);
const readingMinutes = Math.max(1, Math.ceil(((post.body || '').replace(/\s+/g, '')).length / 500));
const category = resolveCategory(post);

const tocItems = headings
  .filter((h) => h.depth === 2 || h.depth === 3 || h.depth === 4)
  .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  articleSection: category,
  keywords: (tags || []).join(', '),
  url: new URL(`/blog/${slug}/`, Astro.site ?? Astro.url).toString(),
};
---

<BaseLayout title={title} description={description} image={coverImage}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <div class="detail-wrapper" data-reveal>
    <Sidebar tocItems={tocItems} minimal />

    <article class="detail-view">
      <header class="detail-header">
        <h1 class="detail-title">{title}</h1>
        <div class="detail-meta">
          <span>📅 <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
          <span>◷ 阅读 {readingMinutes} 分钟</span>
          {updatedDate && (
            <span>✏️ 更新于 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
          )}
          {category && <span>📂 <a href={`/category/${category}/`}>{category}</a></span>}
        </div>
        {tags.length > 0 && (
          <div class="detail-tags">
            {tags.map((t: string) => <a href={`/tag/${t}/`} class="tag">{t}</a>)}
          </div>
        )}
      </header>

      {coverImage && (
        <div class="detail-cover">
          <img src={coverImage} alt={title} />
        </div>
      )}

      <div class="detail-content markdown-body">
        <Content />
      </div>

      <div class="detail-actions">
        <LikeButton client:visible essaySlug={slug} />
      </div>

      <CommentSection client:visible essaySlug={slug} />
    </article>
  </div>
</BaseLayout>

<style>
  .reading-progress { position:fixed; left:0; right:0; top:72px; z-index:90; height:3px; background:transparent; pointer-events:none; } .reading-progress span { display:block; width:0; height:100%; background:linear-gradient(90deg,var(--color-signal),var(--color-signal-cool)); transform-origin:left; transition:width 80ms linear; }
  .detail-wrapper { display:grid; grid-template-columns:190px minmax(0,930px); gap:clamp(24px,4vw,48px); max-width:var(--shell-width); margin:0 auto; padding:clamp(42px,6vw,76px) 0 90px; align-items:start; justify-content:center; }
  .detail-view { min-width:0; overflow:hidden; border:1px solid rgb(16 24 32 / .09); border-radius:24px; background:var(--color-surface); box-shadow:0 32px 90px rgb(16 24 32 / .11); }
  :root[data-theme="dark"] .detail-view { border-color:var(--color-fog); }
  .detail-header { position:relative; margin:0; padding:clamp(38px,7vw,72px) clamp(28px,7vw,70px) 38px; border-bottom:1px solid var(--color-fog); background:linear-gradient(145deg,var(--color-surface) 55%,var(--color-surface-raised)); }
  .detail-header::after { content:''; position:absolute; right:-65px; top:-70px; width:220px; height:220px; border:1px solid rgb(228 155 82 / .18); border-radius:50%; box-shadow:0 0 0 32px rgb(228 155 82 / .05),0 0 0 64px rgb(118 169 184 / .04); pointer-events:none; }
  .article-kicker { position:relative; z-index:1; display:flex; align-items:center; gap:10px; margin-bottom:22px; color:var(--color-text-faint); font:700 .68rem/1 var(--font-ui); letter-spacing:.16em; } .article-kicker span:first-child { padding:5px 8px; border-radius:999px; background:var(--primary-color-light); color:var(--color-signal); letter-spacing:.08em; }
  .detail-title { position:relative; z-index:1; max-width:680px; margin:0 0 20px; color:var(--color-ink); font:600 clamp(2.25rem,4.4vw,3.9rem)/1.08 var(--font-display); letter-spacing:-.065em; text-wrap:balance; } :root[data-theme="dark"] .detail-title { color:var(--color-text); }
  .detail-lead { position:relative; z-index:1; max-width:610px; margin:0 0 26px; color:var(--color-text-muted); font-size:var(--text-lg); line-height:1.75; }
  .detail-meta { position:relative; z-index:1; display:flex; flex-wrap:wrap; gap:9px 18px; color:var(--color-text-faint); font:var(--text-xs) var(--font-ui); } .detail-meta span { display:inline-flex; align-items:center; gap:5px; } .detail-meta a { color:var(--color-text-muted); } .detail-meta a:hover { color:var(--color-signal); }
  .detail-tags { position:relative; z-index:1; display:flex; flex-wrap:wrap; gap:7px; margin-top:18px; } .tag { padding:5px 10px; border:1px solid var(--color-fog); border-radius:999px; color:var(--color-text-muted); font:var(--text-xs) var(--font-ui); } .tag:hover { border-color:var(--color-signal); color:var(--color-signal); background:var(--primary-color-light); }
  .detail-cover { margin:0; max-height:460px; overflow:hidden; border-bottom:1px solid var(--color-fog); } .detail-cover img { display:block; width:100%; height:100%; object-fit:cover; }
  .detail-content { padding:42px clamp(28px,7vw,70px) 16px; }
  .detail-actions { padding:24px clamp(28px,7vw,70px) 0; }
  .detail-actions > * { width:100%; }
  .detail-view :global(.comment-section) { margin-left:clamp(28px,7vw,70px); margin-right:clamp(28px,7vw,70px); margin-bottom:54px; }
  @media (max-width:980px) { .detail-wrapper { grid-template-columns:180px minmax(0,1fr); gap:24px; } }
  @media (max-width:760px) { .reading-progress { top:62px; } .detail-wrapper { display:block; padding:20px 0 48px; } .detail-wrapper > .sidebar { position:static; margin-bottom:14px; } .detail-view { border-radius:18px; } .detail-header { padding:34px 24px 28px; } .detail-title { font-size:clamp(2.15rem,11vw,3.25rem); } .detail-lead { font-size:1rem; } .detail-content { padding:28px 24px 8px; } .detail-actions { padding:20px 24px 0; } .detail-view :global(.comment-section) { margin-left:24px; margin-right:24px; margin-bottom:34px; } }
</style>

<script is:inline>
(function () {
  const links = document.querySelectorAll('.toc-item[data-toc-target]');
  if (!links.length) return;

  const headingMap = new Map();
  links.forEach((link) => {
    const id = link.getAttribute('data-toc-target');
    const heading = document.getElementById(id);
    if (heading) headingMap.set(heading, link);
  });

  if (!headingMap.size) return;

  let current = null;
  function setActive(link) {
    if (current === link) return;
    if (current) current.classList.remove('toc-active');
    current = link;
    if (current) current.classList.add('toc-active');
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          setActive(headingMap.get(entry.target));
        }
      }
    },
    { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
  );

  headingMap.forEach((_, heading) => observer.observe(heading));
})();
</script>

<script is:inline>
(() => { const bar = document.querySelector('.reading-progress span'); const article = document.querySelector('.detail-view'); if (!bar || !article) return; const update = () => { const max = document.documentElement.scrollHeight - window.innerHeight; bar.style.width = (max > 0 ? Math.min(100, Math.max(0, window.scrollY / max * 100)) : 0) + '%'; }; window.addEventListener('scroll', update, { passive: true }); update(); })();
</script>

<script is:inline>
(() => {
  document.querySelectorAll('.markdown-body pre').forEach((pre) => {
    if (pre.querySelector('.code-copy-button')) return;
    const bar = document.createElement('div');
    bar.className = 'code-toolbar';
    const lang = document.createElement('span');
    lang.className = 'code-language';
    lang.textContent = (pre.className.match(/language-([\w-]+)/)?.[1] || 'code').toUpperCase();
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy-button';
    button.textContent = '复制';
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent || '';
      try { await navigator.clipboard.writeText(code); button.textContent = '已复制'; setTimeout(() => { button.textContent = '复制'; }, 1400); }
      catch { button.textContent = '复制失败'; setTimeout(() => { button.textContent = '复制'; }, 1400); }
    });
    bar.append(lang, button); pre.prepend(bar);
  });
})();
</script>
