---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LikeButton from '@/components/islands/LikeButton.vue';
import CommentSection from '@/components/islands/CommentSection.vue';
import Sidebar from '@/components/Sidebar.astro';
import { formatDate, getAllPosts, getPostDescription, getSlug, resolveCategory, resolveTags } from '@/lib/posts';
import '@/styles/markdown.css';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: getSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const slug = getSlug(post);
const { title, pubDate, updatedDate, coverImage } = post.data;
const tags = resolveTags(post);
const readingMinutes = Math.max(1, Math.ceil(((post.body || '').replace(/\s+/g, '')).length / 500));
const category = resolveCategory(post);
// OG/meta description：优先 frontmatter.description，缺省时从正文自动提取
const description = getPostDescription(post);

// 相邻文章（文章列表按发布时间降序）
const allPosts = await getAllPosts();
const currentIndex = allPosts.findIndex((p) => getSlug(p) === slug);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;   // 更新的文章
const olderPost = (currentIndex >= 0 && currentIndex < allPosts.length - 1) ? allPosts[currentIndex + 1] : null; // 更早的文章
function postUrl(p: CollectionEntry<'blog'>): string {
  return '/blog/' + getSlug(p) + '/';
}

const tocItems = headings
  .filter((h) => h.depth === 2 || h.depth === 3 || h.depth === 4)
  .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  articleSection: category,
  keywords: (tags || []).join(', '),
  url: new URL(`/blog/${slug}/`, Astro.site ?? Astro.url).toString(),
};
---

<BaseLayout title={title} description={description} image={coverImage}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="图片预览">
    <img id="lightbox-img" src="" alt="" />
  </div>
  <div class="detail-wrapper">
    <Sidebar tocItems={tocItems} minimal />

    <article class="detail-view">
      <header class="detail-header">
        <h1 class="detail-title">{title}</h1>
        <div class="detail-meta">
          <span><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span>◷ 阅读 {readingMinutes} 分钟</span>
          {updatedDate && (
            <span class="meta-sep" aria-hidden="true">·</span>
          )}
          {updatedDate && (
            <span>更新于 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
          )}
          {category && <a href={`/category/${category}/`} class="meta-cat">{category}</a>}
        </div>
        {tags.length > 0 && (
          <div class="detail-tags">
            {tags.map((t: string) => <a href={`/tag/${t}/`} class="chip tag">{t}</a>)}
          </div>
        )}
      </header>

      {coverImage && (
        <div class="detail-cover">
          <img src={coverImage} alt={title} />
        </div>
      )}

      <div class="detail-content markdown-body">
        <Content />
      </div>

      <div class="detail-actions">
        <LikeButton client:visible essaySlug={slug} />
        <button class="share-button" id="share-button" type="button">
          <span class="share-icon" aria-hidden="true">↗</span>
          <span class="share-copy"><strong>分享这篇文章</strong><small>系统分享或复制链接</small></span>
        </button>
      </div>

      {(newerPost || olderPost) && (
        <nav class="detail-pager" aria-label="相邻文章">
          {olderPost && (
            <a href={postUrl(olderPost)} class="pager-link pager-older">
              <span class="pager-label"><span class="pager-arr" aria-hidden="true">←</span> 更早的一篇</span>
              <span class="pager-title">{olderPost.data.title}</span>
            </a>
          )}
          {newerPost && (
            <a href={postUrl(newerPost)} class="pager-link pager-newer">
              <span class="pager-label">更新的一篇 <span class="pager-arr" aria-hidden="true">→</span></span>
              <span class="pager-title">{newerPost.data.title}</span>
            </a>
          )}
        </nav>
      )}

      <CommentSection client:visible essaySlug={slug} />
    </article>
  </div>
</BaseLayout>

<style>
  .reading-progress { position:fixed; left:0; right:0; top:72px; z-index:90; height:3px; background:transparent; pointer-events:none; } .reading-progress span { display:block; width:0; height:100%; background:linear-gradient(90deg,var(--color-signal),var(--color-signal-cool)); transform-origin:left; transition:width 80ms linear; }
  .detail-wrapper { display:grid; grid-template-columns:210px minmax(0,930px); gap:clamp(24px,4vw,48px); max-width:var(--shell-width); margin:0 auto; padding:clamp(42px,6vw,76px) 0 90px; align-items:start; justify-content:center; }
  .detail-view { min-width:0; overflow:hidden; border:1px solid rgb(16 24 32 / .09); border-radius:24px; background:var(--color-surface); box-shadow:0 32px 90px rgb(16 24 32 / .11); }
  :root[data-theme="dark"] .detail-view { border-color:var(--color-fog); }
  .detail-header { position:relative; margin:0; padding:clamp(38px,7vw,72px) clamp(28px,7vw,70px) 38px; border-bottom:1px solid var(--color-fog); background:linear-gradient(145deg,var(--color-surface) 55%,var(--color-surface-raised)); }
  .detail-header::after { content:''; position:absolute; right:-65px; top:-70px; width:220px; height:220px; border:1px solid rgb(228 155 82 / .18); border-radius:50%; box-shadow:0 0 0 32px rgb(228 155 82 / .05),0 0 0 64px rgb(118 169 184 / .04); pointer-events:none; }
  .detail-title { position:relative; z-index:1; max-width:680px; margin:0 0 20px; color:var(--color-ink); font:600 clamp(2.25rem,4.4vw,3.9rem)/1.08 var(--font-display); letter-spacing:-.065em; text-wrap:balance; } :root[data-theme="dark"] .detail-title { color:var(--color-text); }
  .detail-lead { position:relative; z-index:1; max-width:610px; margin:0 0 26px; color:var(--color-text-muted); font-size:var(--text-lg); line-height:1.75; }
  .detail-meta { position:relative; z-index:1; display:flex; flex-wrap:wrap; align-items:center; gap:9px 12px; color:var(--color-text-faint); font:var(--text-xs) var(--font-ui); font-variant-numeric:tabular-nums; } .detail-meta span { display:inline-flex; align-items:center; gap:5px; } .detail-meta .meta-sep { color:var(--color-fog-strong); } .detail-meta a { color:var(--color-text-muted); transition:color var(--motion-fast); } .detail-meta a:hover { color:var(--color-signal); }
  .meta-cat { display:inline-flex; align-items:center; padding:3px 10px; border:1px solid var(--color-fog); border-radius:999px; font-weight:500; transition:border-color var(--motion-fast),color var(--motion-fast),background-color var(--motion-fast); }
  .detail-meta .meta-cat, .detail-meta .meta-cat:hover { color:var(--color-text-muted); }
  .detail-meta .meta-cat:hover { border-color:var(--color-signal); background:var(--color-signal-soft); color:var(--color-signal); }
  .detail-tags { position:relative; z-index:1; display:flex; flex-wrap:wrap; gap:7px; margin-top:18px; } .tag:hover { transform:translateY(-1px); }
  .detail-cover { margin:0; max-height:460px; min-height:220px; overflow:hidden; border-bottom:1px solid var(--color-fog); } .detail-cover img { display:block; width:100%; height:100%; object-fit:cover; cursor:zoom-in; transition:transform var(--motion-slow) var(--ease-emphasis); }
  .detail-cover img:hover { transform:scale(1.015); }
  .detail-content { padding:42px clamp(28px,7vw,70px) 16px; }
  .detail-actions { padding:24px clamp(28px,7vw,70px) 0; display:flex; flex-direction:column; gap:14px; }
  .detail-actions > * { width:100%; }
  .share-button { display:grid; grid-template-columns:46px minmax(0,1fr) 28px; align-items:center; gap:14px; padding:16px 18px; border:1px solid var(--color-fog); border-radius:var(--radius-md); background:var(--color-surface-raised); color:var(--color-text); cursor:pointer; text-align:left; transition:transform var(--motion-base) var(--ease-standard),border-color var(--motion-base),box-shadow var(--motion-base),background var(--motion-base); }
  .share-button:hover { transform:translateY(-2px); border-color:var(--color-signal-cool); box-shadow:var(--shadow-soft); }
  .share-icon { display:grid; place-items:center; width:46px; height:46px; border-radius:50%; background:var(--color-signal-cool); color:#fff; font-size:1.2rem; line-height:1; transition:transform var(--motion-base) var(--ease-emphasis); }
  .share-button:hover .share-icon { transform:rotate(-8deg) scale(1.06); }
  .share-copy { display:flex; flex-direction:column; gap:4px; min-width:0; }
  .share-copy strong { font:600 var(--text-sm)/1.2 var(--font-ui); }
  .share-copy small { color:var(--color-text-muted); font:var(--text-xs)/1.2 var(--font-ui); }
  @media (max-width:680px) { .share-button { padding:14px; } .share-icon { width:40px; height:40px; } }
  .detail-view :global(.comment-section) { margin-left:clamp(28px,7vw,70px); margin-right:clamp(28px,7vw,70px); margin-bottom:54px; }

  .lightbox { position:fixed; inset:0; z-index:400; display:flex; align-items:center; justify-content:center; padding:32px; background:rgb(8 12 16 / .82); backdrop-filter:blur(6px); animation:fade-in var(--motion-base) var(--ease-standard); }
  .lightbox[hidden] { display:none; }
  .lightbox img { max-width:92vw; max-height:88vh; border-radius:10px; box-shadow:var(--shadow-float); cursor:zoom-out; animation:zoom-in var(--motion-base) var(--ease-emphasis); }
  @keyframes fade-in { from { opacity:0; } to { opacity:1; } }
  @keyframes zoom-in { from { opacity:0; transform:scale(.965); } to { opacity:1; transform:none; } }

  .detail-pager { display:grid; grid-template-columns:1fr 1fr; gap:14px; padding:30px clamp(28px,7vw,70px) 0; }
  .pager-link { display:flex; flex-direction:column; gap:6px; padding:16px 18px; border:1px solid var(--color-fog); border-radius:14px; background:var(--color-surface-raised); text-decoration:none; transition:border-color var(--motion-fast) var(--ease-standard),transform var(--motion-base) var(--ease-standard),box-shadow var(--motion-base); }
  .pager-link:hover { border-color:var(--color-signal); transform:translateY(-2px); box-shadow:var(--shadow-soft); }
  .pager-label { display:inline-flex; align-items:center; gap:5px; color:var(--color-text-faint); font:600 var(--text-xs) var(--font-ui); letter-spacing:.06em; }
  .pager-arr { display:inline-block; color:var(--color-signal); transition:transform var(--motion-base) var(--ease-emphasis); }
  .pager-older:hover .pager-arr { transform:translateX(-3px); }
  .pager-newer:hover .pager-arr { transform:translateX(3px); }
  .pager-title { color:var(--color-text); font:600 .95rem/1.4 var(--font-display); transition:color var(--motion-fast); }
  .pager-link:hover .pager-title { color:var(--color-signal); }
  .pager-newer { text-align:right; }
  @media (max-width:680px) { .detail-pager { grid-template-columns:1fr; } }
  @media (max-width:980px) { .detail-wrapper { grid-template-columns:180px minmax(0,1fr); gap:24px; } }
  @media (max-width:760px) { .reading-progress { top:62px; } .detail-wrapper { display:block; padding:20px 0 48px; } .detail-wrapper > .sidebar { position:static; margin-bottom:14px; } .detail-view { border-radius:18px; } .detail-header { padding:34px 24px 28px; } .detail-title { font-size:clamp(2.15rem,11vw,3.25rem); } .detail-lead { font-size:1rem; } .detail-content { padding:28px 24px 8px; } .detail-actions { padding:20px 24px 0; } .detail-view :global(.comment-section) { margin-left:24px; margin-right:24px; margin-bottom:34px; } }
</style>

<script is:inline>
(function () {
  const links = document.querySelectorAll('.toc-item[data-toc-target]');
  if (!links.length) return;

  const headingMap = new Map();
  links.forEach((link) => {
    const id = link.getAttribute('data-toc-target');
    const heading = document.getElementById(id);
    if (heading) headingMap.set(heading, link);
  });

  if (!headingMap.size) return;

  let current = null;
  function setActive(link) {
    if (current === link) return;
    if (current) current.classList.remove('toc-active');
    current = link;
    if (current) current.classList.add('toc-active');
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          setActive(headingMap.get(entry.target));
        }
      }
    },
    { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
  );

  headingMap.forEach((_, heading) => observer.observe(heading));
})();
</script>

<script is:inline>
(() => { const bar = document.querySelector('.reading-progress span'); const article = document.querySelector('.detail-view'); if (!bar || !article) return; const update = () => { const max = document.documentElement.scrollHeight - window.innerHeight; bar.style.width = (max > 0 ? Math.min(100, Math.max(0, window.scrollY / max * 100)) : 0) + '%'; }; window.addEventListener('scroll', update, { passive: true }); update(); })();
</script>

<script is:inline>
(() => {
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img');
  if (!lb || !lbImg) return;
  let lastFocused = null;
  function open(src, alt) {
    lastFocused = document.activeElement;
    lbImg.src = src || '';
    lbImg.alt = alt || '';
    lb.hidden = false;
    document.body.classList.add('modal-open');
    lbImg.focus();
  }
  function close() {
    lb.hidden = true;
    lbImg.src = '';
    document.body.classList.remove('modal-open');
    if (lastFocused && lastFocused.focus) lastFocused.focus();
  }
  document.querySelectorAll('.detail-cover img, .markdown-body img').forEach((img) => {
    img.style.cursor = 'zoom-in';
    img.addEventListener('click', (e) => {
      e.preventDefault();
      open(img.getAttribute('src'), img.getAttribute('alt'));
    });
  });
  lb.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !lb.hidden) close();
  });
})();
</script>

<script is:inline>
(() => {
  const btn = document.getElementById('share-button');
  if (!btn) return;
  const url = window.location.href;
  const title = document.title;
  const feedback = btn.querySelector('strong');
  btn.addEventListener('click', async () => {
    if (navigator.share) {
      try { await navigator.share({ title, url }); return; } catch (e) { /* 用户取消则走复制 */ }
    }
    try {
      await navigator.clipboard.writeText(url);
      if (feedback) {
        const old = feedback.textContent;
        feedback.textContent = '链接已复制';
        setTimeout(() => { feedback.textContent = old; }, 1600);
      }
    } catch (e) { /* ignore */ }
  });
})();
</script>

<script is:inline>
(() => {
  document.querySelectorAll('.markdown-body pre').forEach((pre) => {
    if (pre.querySelector('.code-copy-button')) return;
    const bar = document.createElement('div');
    bar.className = 'code-toolbar';
    const lang = document.createElement('span');
    lang.className = 'code-language';
    lang.textContent = (pre.className.match(/language-([\w-]+)/)?.[1] || 'code').toUpperCase();
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy-button';
    button.textContent = '复制';
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent || '';
      try { await navigator.clipboard.writeText(code); button.textContent = '已复制'; setTimeout(() => { button.textContent = '复制'; }, 1400); }
      catch { button.textContent = '复制失败'; setTimeout(() => { button.textContent = '复制'; }, 1400); }
    });
    bar.append(lang, button); pre.prepend(bar);
  });
})();
</script>
