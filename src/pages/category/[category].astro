---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getAllPosts, resolveCategory } from '@/lib/posts';

export async function getStaticPaths() {
  const PAGE_SIZE = 50;
  const posts = await getAllPosts();
  const categories = [...new Set(posts.map((p) => resolveCategory(p)))];
  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      posts: posts.filter((p) => resolveCategory(p) === category).slice(0, PAGE_SIZE),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`分类：${category}`}>
  <div class="page-layout">
    <Sidebar />
    <section class="category-page">
      <header class="page-header">
        <p class="breadcrumb"><a href="/">首页</a> / 分类</p>
        <h1>{category}</h1>
        <p class="page-desc">共 {posts.length} 篇文章</p>
      </header>
      <div class="cards">
        {posts.map((post: any) => <PostCard post={post} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-layout {
    display: flex;
    gap: 40px;
    padding: 40px 0;
    align-items: flex-start;
  }
  .category-page { flex: 1; min-width: 0; }
  .page-header { margin-bottom: 24px; }
  .breadcrumb { font-size: 13px; color: var(--text-secondary); margin-bottom: 8px; }
  .page-header h1 { font-size: 28px; margin: 0 0 8px; color: var(--text-color); }
  .page-desc { color: var(--text-secondary); font-size: 14px; margin: 0; }
  .cards { display: flex; flex-direction: column; }

  @media (max-width: 768px) {
    .page-layout { flex-direction: column; gap: 24px; padding: 20px 0; }
  }
</style>
