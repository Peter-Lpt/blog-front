---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getMainCategories, getPostsByCategory } from '@/lib/posts';

export async function getStaticPaths() {
  const PAGE_SIZE = 50;
  const categories = await getMainCategories();
  return Promise.all(Object.keys(categories).map(async (category) => ({
    params: { category },
    props: { category, posts: (await getPostsByCategory(category)).slice(0, PAGE_SIZE) },
  })));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`分类：${category}`}>
  <div class="with-sidebar">
    <Sidebar />
    <section class="category-page">
      <header class="page-head" data-reveal>
        <p class="page-breadcrumb"><a href="/">首页</a><span class="crumb-sep">/</span>分类</p>
        <h1 class="page-title">{category}<span class="accent">.</span></h1>
        <div class="page-head-row">
          <p class="page-desc">这个分类下共 {posts.length} 篇文章。</p>
          <a class="text-link" href="/"><span>查看全部文章</span> <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </header>

      {posts.length === 0 ? (
        <div class="empty-state" data-reveal>
          <p>该分类暂时没有文章</p>
          <p>去看看其他分类，或返回全部文章。</p>
          <a href="/" class="text-link"><span>返回全部文章</span> <span class="arr" aria-hidden="true">→</span></a>
        </div>
      ) : (
        <div class="cards">
          {posts.map((post: any) => <PostCard post={post} />)}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .category-page { flex:1; min-width:0; }
</style>
