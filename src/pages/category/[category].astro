---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getMainCategories, getPostsByCategory } from '@/lib/posts';

export async function getStaticPaths() {
  const PAGE_SIZE = 50;
  const categories = await getMainCategories();
  return Promise.all(Object.keys(categories).map(async (category) => ({
    params: { category },
    props: { category, posts: (await getPostsByCategory(category)).slice(0, PAGE_SIZE) },
  })));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`分类：${category}`}>
  <div class="page-layout">
    <Sidebar />
    <section class="category-page">
      <header class="page-header">
        <p class="breadcrumb"><a href="/">首页</a> / 分类</p>
        <h1>{category}</h1>
        <p class="page-desc">这个分类下共 {posts.length} 篇文章</p>
        <div class="header-actions">
          <a class="back-all" href="/">← 查看全部文章</a>
        </div>
      </header>

      {posts.length === 0 ? (
        <div class="empty">
          <p>该分类暂时没有文章。</p>
          <a href="/">返回全部文章 →</a>
        </div>
      ) : (
        <div class="cards">
          {posts.map((post: any) => <PostCard post={post} />)}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .page-layout { display:flex; gap:40px; padding:40px 0; align-items:flex-start; }
  .category-page { flex:1; min-width:0; }
  .page-header { margin-bottom:24px; padding-bottom:20px; border-bottom:1px solid var(--color-fog); }
  .breadcrumb { font-size:13px; color:var(--color-text-muted); margin-bottom:10px; }
  .page-header h1 { font-size:32px; margin:0 0 8px; color:var(--color-ink); font-family:var(--font-display); letter-spacing:-.02em; }
  :root[data-theme="dark"] .page-header h1 { color:var(--color-text); }
  .page-desc { color:var(--color-text-muted); font-size:14px; margin:0; }
  .header-actions { margin-top:12px; }
  .back-all { display:inline-block; color:var(--color-text-muted); font-size:13px; }
  .back-all:hover { color:var(--color-signal); }
  .cards { display:flex; flex-direction:column; }
  .empty { text-align:center; padding:60px 20px; color:var(--color-text-muted); }
  .empty p { margin:6px 0; }
  .empty a { color:var(--color-signal); }

  @media (max-width:768px) {
    .page-layout { flex-direction:column; gap:24px; padding:20px 0; }
  }
</style>
