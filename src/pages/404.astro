---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 - 页面未找到">
  <div class="not-found">
    <div class="code">404</div>
    <p class="msg">抱歉，你访问的页面不存在。</p>
    <a href="/" class="back-home">← 返回首页</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 100px 20px;
  }
  .code {
    font-size: 96px;
    font-weight: 700;
    color: var(--color-signal);
    line-height: 1;
    margin-bottom: 16px;
  }
  .msg {
    color: var(--color-text-muted);
    font-size: 16px;
    margin-bottom: 24px;
  }
  .back-home {
    display: inline-block;
    padding: 10px 24px;
    background: var(--color-signal);
    color: #fff;
    border-radius: 8px;
  }
  .back-home:hover { opacity: 0.9; color: #fff; }
</style>
