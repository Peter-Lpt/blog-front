---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 - 页面未找到">
  <div class="not-found" data-reveal>
    <p class="eyebrow">PAGE NOT FOUND</p>
    <div class="code" aria-hidden="true">4<span>0</span>4<i>.</i></div>
    <h1 class="msg-title">这一页走丢了</h1>
    <p class="msg">你访问的地址不存在，或者已经被移动到别处。</p>
    <div class="actions">
      <a href="/" class="btn-solid">返回首页 <span class="arr" aria-hidden="true">→</span></a>
      <a href="/archives/" class="text-link"><span>浏览全部文章</span> <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(72px, 12vw, 128px) 20px;
    text-align: center;
  }
  .eyebrow { margin: 0 0 18px; color: var(--color-text-faint); font: 600 var(--text-xs)/1 var(--font-ui); letter-spacing: .2em; }
  .code {
    color: var(--color-ink);
    font: 600 clamp(5.5rem, 16vw, 8.5rem)/1 var(--font-display);
    letter-spacing: -.06em;
    animation: drift 7s ease-in-out infinite;
  }
  :root[data-theme="dark"] .code { color: var(--color-text); }
  .code span { display: inline-block; color: var(--color-signal); }
  .code i { font-style: normal; color: var(--color-signal); }
  @keyframes drift { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  .msg-title { margin: 22px 0 10px; color: var(--color-text); font: 600 clamp(1.3rem, 3.6vw, 1.7rem)/1.3 var(--font-display); letter-spacing: -.02em; }
  .msg { margin: 0 0 30px; color: var(--color-text-muted); font-size: var(--text-sm); line-height: 1.75; }
  .actions { display: flex; justify-content: center; align-items: center; gap: 22px; flex-wrap: wrap; }
</style>
