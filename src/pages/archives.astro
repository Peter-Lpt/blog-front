---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getArchives, formatDate, getSlug } from '@/lib/posts';

const archives = await getArchives();
const total = Object.values(archives).reduce((n, posts) => n + posts.length, 0);

// 按年份分组（archives 的 key 形如 YYYY-MM，且按时间降序）
const yearGroups: { year: string; months: { month: string; posts: any[] }[] }[] = [];
Object.entries(archives).forEach(([month, posts]) => {
  const year = month.slice(0, 4);
  const last = yearGroups[yearGroups.length - 1];
  if (last && last.year === year) last.months.push({ month, posts });
  else yearGroups.push({ year, months: [{ month, posts }] });
});
---

<BaseLayout title="归档" description="按时间线查看全部文章">
  <div class="with-sidebar">
    <Sidebar />
    <section class="archive-page">
      <header class="page-head" data-reveal>
        <p class="page-breadcrumb"><a href="/">首页</a><span class="crumb-sep">/</span>归档</p>
        <h1 class="page-title">归档<span class="accent">.</span></h1>
        <div class="page-head-row">
          <p class="page-desc">共 {total} 篇文章，按时间线翻阅每一次记录。</p>
          <a class="text-link" href="/"><span>返回全部文章</span> <span class="arr" aria-hidden="true">←</span></a>
        </div>
      </header>

      {total === 0 ? (
        <div class="empty-state" data-reveal><p>暂无文章</p><p>这里还没有公开内容，新的记录正在准备中。</p></div>
      ) : (
        <div class="archive-timeline">
          {yearGroups.map((group) => (
            <section class="archive-year" data-reveal>
              <h2 class="year-label"><span>{group.year}</span></h2>
              <div class="year-line">
                {group.months.map(({ month, posts }) => (
                  <div class="month-block" id={month}>
                    <h3 class="month-label">{month.replace(/^\d{4}-/, '')} 月 <span class="count">({posts.length})</span></h3>
                    <ul class="month-posts">
                      {posts.map((post) => (
                        <li>
                          <span class="post-date">{formatDate(post.data.pubDate)}</span>
                          <a href={`/blog/${getSlug(post)}/`} class="post-title">
                            {post.data.title}
                          </a>
                          <span class="row-arrow" aria-hidden="true">→</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .archive-page { flex:1; min-width:0; }

  .archive-timeline { position:relative; }
  .archive-year { margin-bottom:36px; }
  .year-label { display:flex; align-items:center; gap:12px; font-size:20px; font-family:var(--font-display); color:var(--color-text); margin:0 0 16px; }
  .year-label::after { content:''; flex:1; height:1px; background:var(--color-fog); }
  .year-label span { color:var(--color-signal); padding:2px 10px; border:1px solid rgb(228 155 82 / .35); border-radius:999px; background:var(--color-signal-soft); font-size:14px; font-variant-numeric:tabular-nums; }

  .year-line { position:relative; padding-left:22px; }
  .year-line::before { content:''; position:absolute; left:7px; top:6px; bottom:6px; width:2px; background:var(--color-fog); }

  .month-block { position:relative; margin-bottom:18px; }
  .month-block::before { content:''; position:absolute; left:-22px; top:8px; width:10px; height:10px; border-radius:50%; background:var(--color-signal); box-shadow:0 0 0 4px var(--color-signal-soft); transition:box-shadow var(--motion-base) var(--ease-standard),transform var(--motion-base) var(--ease-emphasis); }
  .month-block:hover::before { transform:scale(1.25); box-shadow:0 0 0 7px var(--color-signal-soft); }
  .month-label { font-size:15px; font-weight:600; color:var(--color-text); margin:0 0 8px; }
  .count { font-size:13px; color:var(--color-text-muted); font-weight:400; font-variant-numeric:tabular-nums; }

  .month-posts { list-style:none; padding:10px 14px; margin:0; border:1px solid var(--color-fog); border-radius:12px; background:var(--color-surface); overflow:hidden; }
  .month-posts li { display:flex; align-items:center; gap:16px; padding:9px 10px; margin:0 -10px; border-bottom:1px dashed var(--color-fog); border-radius:8px; transition:background-color var(--motion-fast) var(--ease-standard); }
  .month-posts li:hover { background:var(--color-signal-soft); }
  .month-posts li:last-child { border-bottom:0; }
  .post-date { font-size:13px; color:var(--color-text-muted); flex-shrink:0; width:92px; font-variant-numeric:tabular-nums; }
  .post-title { flex:1; min-width:0; color:var(--color-text); transition:color var(--motion-fast); }
  .post-title:hover { color:var(--color-signal); }
  .row-arrow { color:var(--color-signal); font-size:.85rem; opacity:0; transform:translateX(-6px); transition:opacity var(--motion-base) var(--ease-standard),transform var(--motion-base) var(--ease-emphasis); }
  .month-posts li:hover .row-arrow { opacity:1; transform:none; }
  .empty { text-align:center; padding:60px 20px; color:var(--color-text-muted); }

  @media (max-width:768px) {
    .post-date { width:82px; }
    .row-arrow { display:none; }
  }
</style>
