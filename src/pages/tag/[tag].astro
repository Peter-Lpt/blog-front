---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getAllTags, getPostsByTag } from '@/lib/posts';

export async function getStaticPaths() {
  const PAGE_SIZE = 50;
  const tags = await getAllTags();
  return Promise.all(Object.keys(tags).map(async (tag) => ({
    params: { tag },
    props: { tag, posts: (await getPostsByTag(tag)).slice(0, PAGE_SIZE) },
  })));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`}>
  <div class="with-sidebar">
    <Sidebar />
    <section class="tag-page">
      <header class="page-head" data-reveal>
        <p class="page-breadcrumb"><a href="/">首页</a><span class="crumb-sep">/</span><a href="/tag/">标签</a></p>
        <h1 class="page-title"><span class="accent">#</span>{tag}</h1>
        <div class="page-head-row">
          <p class="page-desc">共 {posts.length} 篇文章打了这个标签。</p>
          <a class="text-link" href="/tag/"><span>浏览全部标签</span> <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </header>

      {posts.length === 0 ? (
        <div class="empty-state" data-reveal>
          <p>该标签下暂无文章</p>
          <p>换个标签看看，或返回全部文章。</p>
          <a href="/" class="text-link"><span>返回全部文章</span> <span class="arr" aria-hidden="true">→</span></a>
        </div>
      ) : (
        <div class="cards">
          {posts.map((post: any) => <PostCard post={post} />)}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .tag-page { flex:1; min-width:0; }
</style>
