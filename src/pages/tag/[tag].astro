---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getAllTags, getPostsByTag } from '@/lib/posts';

export async function getStaticPaths() {
  const PAGE_SIZE = 50;
  const tags = await getAllTags();
  return Promise.all(Object.keys(tags).map(async (tag) => ({
    params: { tag },
    props: { tag, posts: (await getPostsByTag(tag)).slice(0, PAGE_SIZE) },
  })));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`}>
  <div class="page-layout">
    <Sidebar />
    <section class="tag-page">
      <header class="page-header">
        <p class="breadcrumb"><a href="/">首页</a> / 标签</p>
        <h1>{tag}</h1>
        <p class="page-desc">共 {posts.length} 篇文章</p>
      </header>
      <div class="cards">
        {posts.map((post: any) => <PostCard post={post} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-layout {
    display: flex;
    gap: 40px;
    padding: 40px 0;
    align-items: flex-start;
  }
  .tag-page { flex: 1; min-width: 0; }
  .page-header { margin-bottom: 24px; }
  .breadcrumb { font-size: 13px; color: var(--color-text-muted); margin-bottom: 8px; }
  .page-header h1 { font-size: 28px; margin: 0 0 8px; color: var(--color-text); }
  .page-desc { color: var(--color-text-muted); font-size: 14px; margin: 0; }
  .cards { display: flex; flex-direction: column; }

  @media (max-width: 768px) {
    .page-layout { flex-direction: column; gap: 24px; padding: 20px 0; }
  }
</style>
