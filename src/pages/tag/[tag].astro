---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getPublishedPosts } from '@/lib/posts';

export async function getStaticPaths() {
  const PAGE_SIZE = 50;
  const posts = await getPublishedPosts();
  const allTags = new Set<string>();
  posts.forEach((p) => (p.data.tags || []).forEach((t) => allTags.add(t)));
  return [...allTags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => (p.data.tags || []).includes(tag)).slice(0, PAGE_SIZE),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`}>
  <section class="tag-page">
    <header class="page-header">
      <p class="breadcrumb"><a href="/">首页</a> / 标签</p>
      <h1>#️⃣ {tag}</h1>
      <p class="page-desc">共 {posts.length} 篇文章</p>
    </header>
    <div class="cards">
      {posts.map((post: any) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .tag-page { padding: 40px 0; }
  .page-header { margin-bottom: 24px; }
  .breadcrumb { font-size: 13px; color: var(--text-secondary); margin-bottom: 8px; }
  .page-header h1 { font-size: 28px; margin: 0 0 8px; color: var(--text-color); }
  .page-desc { color: var(--text-secondary); font-size: 14px; margin: 0; }
  .cards { display: flex; flex-direction: column; }
</style>
