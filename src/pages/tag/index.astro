---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getAllTags } from '@/lib/posts';

const tags = await getAllTags();
---

<BaseLayout title="标签" description="按标签浏览全部文章">
  <div class="with-sidebar">
    <Sidebar />
    <section class="tag-index">
      <header class="page-head" data-reveal>
        <p class="page-breadcrumb"><a href="/">首页</a><span class="crumb-sep">/</span>标签</p>
        <h1 class="page-title">标签<span class="accent">.</span></h1>
        <p class="page-desc">共 {Object.keys(tags).length} 个标签，点击进入对应文章。</p>
      </header>

      {Object.keys(tags).length === 0 ? (
        <div class="empty-state" data-reveal><p>暂无标签</p><p>发布文章后标签会出现在这里。</p></div>
      ) : (
        <div class="tag-grid">
          {Object.entries(tags).map(([name, count]) => (
            <a href={`/tag/${name}/`} class="chip tag-chip" data-reveal>
              <span class="tag-name">#{name}</span>
              <span class="chip-count">{count}</span>
            </a>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .tag-index { flex:1; min-width:0; }
  .tag-grid { display:flex; flex-wrap:wrap; gap:10px; padding-top:6px; }
  .tag-chip { font-size:var(--text-sm); padding:8px 15px; }
</style>
