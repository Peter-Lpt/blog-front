---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FriendLinkList from '@/components/islands/FriendLinkList.vue';
---

<BaseLayout title="友情链接" description="友情链接">
  <section class="links-page">
    <header class="page-header">
      <h1>🔗 友情链接</h1>
      <p class="page-desc">互相学习，共同成长</p>
    </header>

    <!-- 数据来自后端 /user/oauth 之外的公开接口 /friendLink/findList（仅展示审核通过的友链） -->
    <FriendLinkList client:load />
  </section>
</BaseLayout>

<style>
  .links-page { padding: 40px 0; }
  .page-header { margin-bottom: 24px; }
  .page-header h1 { font-size: 28px; margin: 0 0 8px; color: var(--color-text); }
  .page-desc { color: var(--color-text-muted); font-size: 14px; margin: 0; }
</style>