---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Pagination from '@/components/Pagination.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getPublishedPosts } from '@/lib/posts';

export async function getStaticPaths() {
  const PAGE_SIZE = 10;
  const posts = await getPublishedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
  return Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => ({
    params: { page: String(page) },
    props: {
      page,
      totalPages,
      posts: posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
    },
  }));
}

const { page, totalPages, posts } = Astro.props;
---

<BaseLayout title={page > 1 ? `第 ${page} 页` : undefined}>
  <div class="home-layout">
    <section class="post-list">
      <div class="cards">
        {posts.map((post: any) => <PostCard post={post} />)}
      </div>
      <Pagination
        currentPage={page}
        totalPages={totalPages}
        baseUrl="/"
      />
    </section>
    <Sidebar />
  </div>
</BaseLayout>

<style>
  .home-layout { display: flex; gap: 48px; padding: 40px 0; align-items: flex-start; }
  .post-list { flex: 1; min-width: 0; }
  .cards { display: flex; flex-direction: column; }
  @media (max-width: 768px) {
    .home-layout { flex-direction: column; gap: 24px; padding: 20px 0; }
  }
</style>
