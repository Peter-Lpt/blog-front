---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Pagination from '@/components/Pagination.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getAllPosts } from '@/lib/posts';

const PAGE_SIZE = 10;

const posts = await getAllPosts();
const total = posts.length;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const currentPosts = posts.slice(0, PAGE_SIZE);
---

<BaseLayout>
  <div class="home-layout">
    <Sidebar />
    <section class="post-list" aria-label="文章列表">
      <h1 class="visually-hidden">文章列表</h1>
      {currentPosts.length === 0 ? (
        <div class="empty">
          <p>暂无文章。</p>
          <p>在 <code>src/content/blog/</code> 目录下创建 Markdown 文件即可。</p>
        </div>
      ) : (
        <div class="cards">
          {currentPosts.map((post) => <PostCard post={post} />)}
        </div>
      )}
      <Pagination currentPage={1} totalPages={totalPages} baseUrl="/" />
    </section>
  </div>
</BaseLayout>

<style>
  .home-layout {
    display: flex;
    gap: 40px;
    padding: 40px 0;
    align-items: flex-start;
  }
  .post-list {
    flex: 1;
    min-width: 0;
  }
  .cards {
    display: flex;
    flex-direction: column;
  }
  .empty {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-secondary);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  @media (max-width: 768px) {
    .home-layout {
      flex-direction: column;
      gap: 24px;
      padding: 20px 0;
    }
  }
</style>
