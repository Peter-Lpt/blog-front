---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Pagination from '@/components/Pagination.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getAllPosts } from '@/lib/posts';
import { SITE } from '@/lib/config';

const PAGE_SIZE = 10;
const posts = await getAllPosts();
const total = posts.length;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const currentPosts = posts.slice(0, PAGE_SIZE);
const featuredPost = currentPosts[0];
---

<BaseLayout>
  <div class="home-layout">
    <Sidebar />
    <section class="post-list" aria-label="文章列表">
      <div class="home-intro" data-reveal>
        <p class="eyebrow">FIELD NOTES / {new Date().getFullYear()}</p>
        <h1>把复杂的事，<em>写清楚。</em></h1>
        <p class="intro-copy">{SITE.description || '记录技术、产品与生活现场，让每一次思考都留下可回看的坐标。'}</p>
        <div class="intro-stats" aria-label="站点统计">
          <span><strong>{total}</strong> 篇文章</span>
          <span><i></i>持续更新中</span>
        </div>
      </div>
      {featuredPost && <div class="section-heading"><span>最近记录</span><a href="/archives/">查看全部 →</a></div>}
      {currentPosts.length === 0 ? (
        <div class="empty" data-reveal><p>暂无文章。</p><p>这里还没有公开文章，新的内容正在准备中。</p></div>
      ) : (
        <div class="cards">{currentPosts.map((post, index) => <PostCard post={post} featured={index === 0} />)}</div>
      )}
      <Pagination currentPage={1} totalPages={totalPages} baseUrl="/" />
    </section>
  </div>
</BaseLayout>

<style>
  .home-layout { display:grid; grid-template-columns:240px minmax(0,1fr); gap:clamp(36px,6vw,88px); padding:clamp(42px,7vw,84px) 0 72px; align-items:start; }
  .post-list { min-width:0; }
  .home-intro { max-width:760px; padding:18px 0 58px; border-bottom:1px solid var(--color-fog); }
  .eyebrow { margin:0 0 20px; color:var(--color-signal); font:600 var(--text-xs)/1 var(--font-ui); letter-spacing:.18em; }
  .home-intro h1 { max-width:720px; margin:0; color:var(--color-ink); font:600 var(--text-display)/1.06 var(--font-display); letter-spacing:-.055em; }
  :root[data-theme="dark"] .home-intro h1 { color:var(--color-text); }
  .home-intro h1 em { color:var(--color-signal); font-style:normal; }
  .intro-copy { max-width:560px; margin:24px 0 28px; color:var(--color-text-muted); font-size:var(--text-lg); line-height:1.8; }
  .intro-stats { display:flex; flex-wrap:wrap; gap:22px; color:var(--color-text-faint); font:var(--text-sm)/1 var(--font-ui); }
  .intro-stats strong { color:var(--color-text); font-size:1.15rem; margin-right:4px; }
  .intro-stats i { display:inline-block; width:7px; height:7px; margin-right:7px; border-radius:50%; background:var(--color-success); box-shadow:0 0 0 4px rgb(109 155 120 / .14); }
  .section-heading { display:flex; justify-content:space-between; align-items:center; gap:16px; padding:32px 0 18px; color:var(--color-text); font:600 var(--text-sm)/1 var(--font-ui); letter-spacing:.04em; }
  .section-heading a { color:var(--color-text-muted); font-size:var(--text-xs); font-weight:500; letter-spacing:0; }
  .section-heading a:hover { color:var(--color-signal); }
  .cards { display:flex; flex-direction:column; gap:16px; }
  .empty { padding:60px 20px; color:var(--color-text-muted); text-align:center; }
  @media (max-width:900px) { .home-layout { grid-template-columns:190px minmax(0,1fr); gap:32px; } }
  @media (max-width:680px) { .home-layout { display:flex; flex-direction:column; gap:28px; padding:28px 0 48px; } .home-intro { padding-bottom:34px; } .home-intro h1 { font-size:clamp(2.8rem,14vw,4.6rem); } .intro-copy { font-size:1rem; } .section-heading { padding-top:24px; } }
</style>
