---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getArchives } from '@/lib/posts';


export async function getStaticPaths() {
  const allArchives = await getArchives();
  return Object.keys(allArchives).map((month) => ({
    params: { month },
    props: { month, posts: allArchives[month] },
  }));
}

const { month, posts } = Astro.props;
---

<BaseLayout title={`${month} 归档`}>
  <div class="with-sidebar">
    <Sidebar />
    <section class="archive-month-page">
      <header class="page-head" data-reveal>
        <p class="page-breadcrumb"><a href="/">首页</a><span class="crumb-sep">/</span><a href="/archives/">归档</a></p>
        <h1 class="page-title">{month}<span class="accent">.</span></h1>
        <p class="page-desc">共 {posts.length} 篇文章。</p>
      </header>
      {posts.length === 0 ? (
        <div class="empty-state" data-reveal><p>该月份没有文章</p><p>去归档页看看其他月份。</p><a href="/archives/" class="text-link"><span>返回归档</span> <span class="arr" aria-hidden="true">→</span></a></div>
      ) : (
        <div class="cards">
          {posts.map((post: any) => <PostCard post={post} />)}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .archive-month-page { flex:1; min-width:0; }
</style>
