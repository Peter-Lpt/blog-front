---
import { SITE } from '@/lib/config';
import ThemeToggle from '@/components/islands/ThemeToggle.vue';
import SearchDialog from '@/components/islands/SearchDialog.vue';
import LoginDialog from '@/components/islands/LoginDialog.vue';

const navItems = [
  { href: '/', label: '所有文章' },
  { href: '/tools/', label: '工具箱' },
  { href: '/friend-links/', label: '友情链接' },
  { href: '/about/', label: '关于' },
];

const pathname = Astro.url.pathname;
const current = pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="header-inner container">
    <a href="/" class="logo">{SITE.title}</a>
    <nav class="nav" aria-label="主导航">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: current === item.href.replace(/\/$/, '') || (item.href !== '/' && current.startsWith(item.href)) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <SearchDialog client:idle />

      <!-- 用户区域：纯 Astro 渲染，inline script 控制显隐 -->
      <div id="auth-user-area" class="user-area hidden">
        <div id="auth-user-menu" class="user-menu">
          <img id="auth-user-avatar" src="" alt="" class="avatar" />
          <div id="auth-user-dropdown" class="dropdown hidden">
            <a id="auth-admin-link" href="/admin/" class="dropdown-item admin-link hidden">
              ⚙️ 进入后台
            </a>
            <label class="dropdown-item avatar-upload-item">
              📷 更换头像
              <input type="file" accept="image/*" class="hidden-input" id="auth-avatar-input" />
            </label>
            <button class="dropdown-item" id="auth-logout-btn">退出登录</button>
          </div>
        </div>
      </div>

      <button id="auth-login-btn" class="login-trigger hidden">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
        </svg>
        登录
      </button>

      <ThemeToggle client:load />
    </div>
  </div>
</header>

<!-- LoginDialog 需要 Vue 岛（Teleport），但只在用户点击登录后才显示 -->
<LoginDialog client:visible />

<style>
  .site-header {
    background: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 24px;
  }
  .logo {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-color);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .logo:hover {
    color: var(--primary-color);
  }
  .nav {
    display: flex;
    gap: 28px;
    margin-left: auto;
  }
  .nav-link {
    color: var(--text-secondary);
    font-size: 15px;
    padding: 6px 0;
    position: relative;
    transition: color 0.2s;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--primary-color);
    transition: width 0.3s;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--text-color);
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* 用户头像菜单 */
  .user-area { position: relative; }
  .user-menu {
    display: flex;
    align-items: center;
    cursor: pointer;
    padding: 4px;
    border-radius: 8px;
    transition: background 0.2s;
  }
  .user-menu:hover { background: var(--glass-bg); }
  .avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    background: var(--card-bg);
    border: var(--card-border);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    min-width: 140px;
    overflow: hidden;
    z-index: 200;
  }
  .dropdown-item {
    display: block;
    width: 100%;
    padding: 10px 16px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-color);
    font-size: 14px;
    text-align: left;
    text-decoration: none;
    box-sizing: border-box;
  }
  .dropdown-item:hover { background: var(--primary-color-light); }
  .admin-link {
    color: var(--primary-color);
    font-weight: 600;
    border-bottom: 1px solid var(--border-color);
    text-decoration: none;
  }
  .avatar-upload-item {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .hidden-input { display: none; }
  .hidden { display: none !important; }
  .login-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--primary-color);
    color: #fff;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
  }
  .login-trigger:hover { opacity: 0.9; }

  @media (max-width: 768px) {
    .header-inner {
      height: 60px;
      gap: 12px;
    }
    .logo {
      font-size: 18px;
    }
    .nav {
      gap: 16px;
    }
    .nav-link {
      font-size: 14px;
    }
  }

  @media (max-width: 480px) {
    .nav {
      gap: 12px;
    }
  }
</style>

<script is:inline define:vars={{ apiBase: SITE.apiBaseUrl }}>
(function () {
  var TOKEN_KEY='blog_token';
  var USER_KEY = 'blog_user';

  function getUser() {
    try {
      var raw = localStorage.getItem(USER_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch { return null; }
  }

  function isLoggedIn() {
    return !!localStorage.getItem(TOKEN_KEY);
  }

  function generateAvatar(seed) {
    var h = 5381;
    for (var i = 0; i < (seed || '').length; i++) {
      h = ((h << 5) + h + seed.charCodeAt(i)) | 0;
    }
    h = Math.abs(h);
    var COLORS = ['#667eea','#f093fb','#4facfe','#43e97b','#fa709a','#30cfd0','#a8edea','#ff9a9e','#ffecd2','#ff6a00'];
    var c = COLORS[h % COLORS.length];
    return 'data:image/svg+xml,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 7 7"><rect width="7" height="7" fill="' + c + '"/><text x="3.5" y="5.2" text-anchor="middle" fill="#fff" font-size="4.5" font-family="sans-serif">' + (seed || '?')[0].toUpperCase() + '</text></svg>'
    );
  }

  function initAuth() {
    var userArea = document.getElementById('auth-user-area');
    var loginBtn = document.getElementById('auth-login-btn');
    var userMenu = document.getElementById('auth-user-menu');
    var userAvatar = document.getElementById('auth-user-avatar');
    var userDropdown = document.getElementById('auth-user-dropdown');
    var adminLink = document.getElementById('auth-admin-link');
    var logoutBtn = document.getElementById('auth-logout-btn');
    var avatarInput = document.getElementById('auth-avatar-input');

    if (!userArea || !loginBtn) return;

    if (isLoggedIn()) {
      var user = getUser();
      var src = (user && user.avatar) || generateAvatar((user && user.username) || 'u');
      if (userAvatar) userAvatar.src = src;
      userArea.classList.remove('hidden');
      loginBtn.classList.add('hidden');
      // 管理员显示后台入口
      if (user && user.role === 'admin' && adminLink) {
        adminLink.classList.remove('hidden');
      }
    } else {
      userArea.classList.add('hidden');
      loginBtn.classList.remove('hidden');
    }

    // 点击头像展开下拉
    if (userMenu && userDropdown) {
      userMenu.onclick = function (e) {
        e.stopPropagation();
        userDropdown.classList.toggle('hidden');
      };
      document.addEventListener('click', function () {
        userDropdown.classList.add('hidden');
      });
    }

    // 退出登录
    if (logoutBtn) {
      logoutBtn.onclick = function () {
        localStorage.removeItem(TOKEN_KEY);
        localStorage.removeItem(USER_KEY);
        location.reload();
      };
    }

    // 头像上传
    if (avatarInput) {
      avatarInput.onchange = function (e) {
        var file = e.target.files && e.target.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function () {
          if (userAvatar) userAvatar.src = reader.result;
          var user = getUser();
          if (user) {
            user.avatar = reader.result;
            localStorage.setItem(USER_KEY, JSON.stringify(user));
          }
        };
        reader.readAsDataURL(file);
        // 上传到后端
        var token = localStorage.getItem(TOKEN_KEY);
        if (token) {
          var fd = new FormData();
          fd.append('file', file);
          fetch(apiBase + '/user/avatar', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + token },
            body: fd
          }).then(function (r) { return r.json(); }).then(function (data) {
            if (data.success && data.data && data.data.avatar) {
              var user = getUser();
              if (user) {
                user.avatar = data.data.avatar;
                localStorage.setItem(USER_KEY, JSON.stringify(user));
              }
              if (userAvatar) userAvatar.src = data.data.avatar;
            }
          }).catch(function () {});
        }
        avatarInput.value = '';
        if (userDropdown) userDropdown.classList.add('hidden');
      };
    }

    // 登录按钮 → 触发 LoginDialog
    loginBtn.onclick = function () {
      document.dispatchEvent(new CustomEvent('open-login'));
    };
  }

  initAuth();
  document.addEventListener('astro:page-load', initAuth);
})();
</script>
