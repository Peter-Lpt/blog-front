---
import { SITE } from '@/lib/config';
import ThemeToggle from '@/components/islands/ThemeToggle.vue';
import SearchDialog from '@/components/islands/SearchDialog.vue';
import LoginDialog from '@/components/islands/LoginDialog.vue';
import AvatarPicker from '@/components/islands/AvatarPicker.vue';

const navItems = [
  { href: '/', label: '所有文章' },
  { href: '/tools/', label: '工具箱' },
  { href: '/friend-links/', label: '友情链接' },
  { href: '/about/', label: '关于' },
];

const pathname = Astro.url.pathname;
const current = pathname.replace(/\/$/, '') || '/';
// 后台入口：dev 指向 admin 自己的 dev server（Astro 托管的 public/admin 是旧构建），生产同源 /admin/
const adminUrl = import.meta.env.PUBLIC_ADMIN_URL || '/admin/';
---

<header class="site-header">
  <div class="header-inner container">
    <a href="/" class="logo">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-word">PeterQs<em>’</em> Blog</span>
    </a>
    <nav class="nav" aria-label="主导航">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', 'nav-item', { 'nav-item-active': item.href === '/' ? (current === '/' || current.startsWith('/blog/') || current.startsWith('/category/') || current.startsWith('/tag/') || current.startsWith('/archives/')) : (current === item.href.replace(/\/$/, '') || current.startsWith(item.href)) }]}
          >
            <span class="nav-item-label">{item.label}</span>
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <button class="search-trigger" id="search-open-btn" type="button" aria-label="搜索（/ 或 Ctrl+K）" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- 用户区域：纯 Astro 渲染，inline script 控制显隐 -->
      <div class="auth-slot" aria-live="polite">
        <div id="auth-user-area" class="user-area hidden">
          <div id="auth-user-menu" class="user-menu" role="button" tabindex="0" aria-haspopup="menu">
            <img id="auth-user-avatar" src="" alt="" class="avatar" />
            <div id="auth-user-dropdown" class="dropdown hidden" role="menu">
              <div class="dropdown-user">
                <img id="auth-dropdown-avatar" src="" alt="" class="dropdown-avatar" />
                <span id="auth-dropdown-name">用户</span>
              </div>
              <a id="auth-admin-link" href={adminUrl} class="dropdown-item admin-link hidden" role="menuitem">
                <span class="dropdown-icon">⚙</span>
                <span>进入后台</span>
              </a>
              <button class="dropdown-item avatar-pick-item" role="menuitem" id="auth-avatar-pick-btn">
                <span class="dropdown-icon">▣</span>
                <span>更换头像</span>
              </button>
              <button class="dropdown-item logout-item" id="auth-logout-btn" role="menuitem">
                <span class="dropdown-icon">↩</span>
                <span>退出登录</span>
              </button>
            </div>
          </div>
        </div>

      <button id="auth-login-btn" class="login-trigger hidden">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
        </svg>
      </button>

      </div>

      <ThemeToggle client:idle />
    </div>
    <!-- 移动端：汉堡按钮（<=680px 显示，唤起抽屉导航） -->
    <button class="menu-toggle" id="menu-toggle" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-drawer">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- 移动端抽屉导航（覆盖层 + 面板） -->
<div class="drawer-overlay" id="drawer-overlay" hidden></div>
<nav class="mobile-drawer" id="mobile-drawer" aria-label="移动端导航" aria-hidden="true">
  <div class="drawer-head">
    <span class="drawer-title">导航</span>
    <button class="drawer-close" id="drawer-close" type="button" aria-label="关闭菜单">✕</button>
  </div>
  <ul class="drawer-list">
    {navItems.map((item, i) => (
      <li style={`--i:${i}`}>
        <a
          href={item.href}
          class="drawer-link nav-item"
          class:list={[{ 'nav-item-active': item.href === '/' ? (current === '/' || current.startsWith('/blog/') || current.startsWith('/category/') || current.startsWith('/tag/') || current.startsWith('/archives/')) : (current === item.href.replace(/\/$/, '') || current.startsWith(item.href)) }]}
        >{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script is:inline>
  (() => {
    const userArea = document.getElementById('auth-user-area');
    const loginButton = document.getElementById('auth-login-btn');
    const avatar = document.getElementById('auth-user-avatar');
    const dropdownName = document.getElementById('auth-dropdown-name');
    if (!userArea || !loginButton) return;
    let user = null;
    try {
      user = JSON.parse(localStorage.getItem('blog_user') || 'null');
    } catch {}
    const token = localStorage.getItem('blog_token');
    if (token && user) {
      if (dropdownName) dropdownName.textContent = user.nickname || user.username || '用户';
      if (avatar && user.avatar) {
        var img = new Image();
        img.onload = function() {
          avatar.src = user.avatar;
          avatar.dataset.inlineSet = '1';
          userArea.classList.remove('hidden');
          loginButton.classList.add('hidden');
        };
        // 头像加载失败（网络/404）时回退默认头像，避免用户区整体隐藏
        img.onerror = function() {
          avatar.dataset.inlineSet = '1';
          userArea.classList.remove('hidden');
          loginButton.classList.add('hidden');
        };
        img.src = user.avatar;
      } else {
        userArea.classList.remove('hidden');
        loginButton.classList.add('hidden');
      }
    } else {
      userArea.classList.add('hidden');
      loginButton.classList.remove('hidden');
    }
  })();

  // 滚动时收紧头部：加深底色 + 轻投影（rAF 节流）
  (() => {
    const header = document.querySelector('.site-header');
    if (!header) return;
    let ticking = false;
    const update = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 10);
      ticking = false;
    };
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }, { passive: true });
    update();
  })();

  // 移动端抽屉导航
  (() => {
    const toggle = document.getElementById('menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('drawer-overlay');
    const closeBtn = document.getElementById('drawer-close');
    if (!toggle || !drawer || !overlay) return;

    function open() {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      overlay.hidden = false;
      document.body.classList.add('drawer-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', '关闭菜单');
      closeBtn?.focus();
    }
    function close() {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      overlay.hidden = true;
      document.body.classList.remove('drawer-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '打开菜单');
      toggle.focus();
    }
    function toggleMenu() {
      drawer.classList.contains('is-open') ? close() : open();
    }
    toggle.addEventListener('click', toggleMenu);
    closeBtn?.addEventListener('click', close);
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
    });
    // 点击抽屉内任意导航后关闭
    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', close);
    });
  })();

  // 搜索触发按钮 → SearchDialog 岛（经 open-search 事件唤起 Teleport 弹窗）
  (() => {
    const btn = document.getElementById('search-open-btn');
    if (!btn) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      document.dispatchEvent(new CustomEvent('open-search'));
    });
  })();
</script>

<!-- LoginDialog 需要 Vue 岛（Teleport），页面加载时注册事件监听器 -->
<LoginDialog client:load />
<!-- 头像选择面板（预设头像 + 自定义上传） -->
<AvatarPicker client:idle />
<!-- 全局搜索（Teleport 弹窗；触发按钮在 header-actions，经 open-search 事件唤起） -->
<SearchDialog client:idle />

<style>
  /* view-transition-name：跨页过渡时 header 独立成层，不随正文淡出/位移 */
  .site-header { position:sticky; top:0; z-index:100; view-transition-name:site-header; background:rgb(243 240 232 / .82); backdrop-filter:blur(var(--glass-blur)); border-bottom:1px solid rgb(216 222 227 / .82); transition:background-color var(--motion-base) var(--ease-standard),border-color var(--motion-base) var(--ease-standard),box-shadow var(--motion-base) var(--ease-standard); } :root[data-theme="dark"] .site-header { background:rgb(20 28 34 / .82); border-color:rgb(52 67 77 / .82); }
  .site-header.is-scrolled { background:rgb(243 240 232 / .95); box-shadow:0 12px 32px rgb(16 24 32 / .07); }
  :root[data-theme="dark"] .site-header.is-scrolled { background:rgb(20 28 34 / .93); box-shadow:0 12px 32px rgb(0 0 0 / .22); }
  .header-inner { display:flex; align-items:center; gap:32px; min-height:72px; }

  /* ---- Logo：blog 字样 + 信号点 ---- */
  .logo { position:relative; display:inline-flex; align-items:center; gap:10px; flex-shrink:0; color:var(--color-ink); text-decoration:none; }
  .logo-mark { position:relative; width:11px; height:11px; flex:0 0 11px; border-radius:50%; background:var(--color-signal); box-shadow:0 0 0 5px rgb(228 155 82 / .14); transition:transform var(--motion-base) var(--ease-emphasis),box-shadow var(--motion-base) var(--ease-standard); }
  .logo-mark::after { content:''; position:absolute; inset:-3px; border-radius:50%; border:1px solid rgb(228 155 82 / .5); opacity:0; transform:scale(.6); transition:all var(--motion-base) var(--ease-emphasis); }
  .logo-word { font:800 1.18rem var(--font-display); letter-spacing:.02em; line-height:1.2; color:var(--color-ink); white-space:nowrap; }
  .logo-word em { font-style:normal; color:var(--color-signal); }
  .logo:hover .logo-mark { transform:scale(1.14); box-shadow:0 0 0 6px rgb(228 155 82 / .2); }
  .logo:hover .logo-mark::after { opacity:1; transform:scale(1); }
  .logo:hover .logo-word { color:var(--color-text); }
  :root[data-theme="dark"] .logo-word { color:var(--color-text); }

  /* ---- Nav：简洁分段式 tabs ---- */
  .nav { display:flex; align-items:center; gap:4px; margin-left:auto; padding:3px; border:1px solid rgb(216 222 227 / .72); border-radius:14px; background:rgb(255 255 255 / .42); box-shadow:0 4px 14px rgb(16 24 32 / .04); transition:background-color var(--motion-base) var(--ease-standard),border-color var(--motion-base) var(--ease-standard); } :root[data-theme="dark"] .nav { border-color:rgb(52 67 77 / .82); background:rgb(24 35 43 / .48); }
  .nav-link { position:relative; display:inline-flex; align-items:center; justify-content:center; min-height:34px; padding:0 15px; border-radius:11px; color:var(--color-text-muted); font:600 .82rem var(--font-ui); text-decoration:none; transition:color 180ms ease,background-color 180ms ease,transform 200ms cubic-bezier(.22,1,.36,1),box-shadow 200ms cubic-bezier(.22,1,.36,1); }
  .nav-link:hover { color:var(--color-text); background:rgb(255 255 255 / .66); box-shadow:0 4px 12px rgb(15 23 42 / .05); transform:translateY(-1px); }
  :root[data-theme="dark"] .nav-link:hover { background:rgb(39 52 62 / .82); }
  .nav-link:active { transform:translateY(0) scale(.98); }
  .nav-item-label { position:relative; z-index:1; display:inline-block; transition:transform 180ms ease,letter-spacing 150ms ease; }
  .nav-link:hover .nav-item-label { transform:scale(1.03); letter-spacing:.01em; }
  .nav-item-active { background:var(--color-signal); color:#fff; box-shadow:0 5px 14px rgb(228 155 82 / .3); }
  .nav-item-active:hover { background:var(--color-signal); color:#fff; }
  :root[data-theme="dark"] .nav-item-active { background:var(--color-signal); color:#fff; }

  .header-actions { display:flex; align-items:center; gap:2px; padding:3px; border:1px solid rgb(216 222 227 / .72); border-radius:14px; background:rgb(255 255 255 / .42); box-shadow:0 5px 14px rgb(16 24 32 / .04); transition:background-color var(--motion-base) var(--ease-standard),border-color var(--motion-base) var(--ease-standard),box-shadow var(--motion-base) var(--ease-standard); } :root[data-theme="dark"] .header-actions { border-color:rgb(52 67 77 / .82); background:rgb(24 35 43 / .48); box-shadow:0 8px 20px rgb(0 0 0 / .12); } .header-actions button { border-radius:10px; }
  .auth-slot { position:relative; width:34px; height:34px; flex:0 0 34px; }
  .auth-slot > .user-area, .auth-slot > .login-trigger { position:absolute; inset:0; }
  .auth-slot > .user-area.hidden, .auth-slot > .login-trigger.hidden { display:flex !important; visibility:hidden; pointer-events:none; }
  .auth-slot > .user-area:not(.hidden), .auth-slot > .login-trigger:not(.hidden) { visibility:visible; pointer-events:auto; }
  .user-area { position:relative; }
  .user-menu { display:flex; align-items:center; justify-content:center; width:34px; height:34px; padding:0; border-radius:999px; cursor:pointer; outline:none; transition:background-color var(--motion-fast) var(--ease-standard),box-shadow var(--motion-base) var(--ease-emphasis),transform var(--motion-fast) var(--ease-standard); }
  .user-menu:hover, .user-menu:focus-visible { background:rgb(255 255 255 / .72); box-shadow:0 8px 18px rgb(228 155 82 / .16); transform:translateY(-1px); }
  :root[data-theme="dark"] .user-menu:hover, :root[data-theme="dark"] .user-menu:focus-visible { background:rgb(39 52 62 / .82); }
  .avatar { width:28px; height:28px; border:2px solid rgb(255 255 255 / .86); border-radius:50%; object-fit:cover; background:linear-gradient(135deg,var(--color-signal),#7dd3fc); box-shadow:0 0 0 1px rgb(228 155 82 / .28),0 6px 14px rgb(16 24 32 / .12); }
  .dropdown { position:absolute; top:calc(100% + 9px); right:-8px; min-width:176px; overflow:hidden; border:1px solid rgb(216 222 227 / .86); border-radius:14px; background:rgb(255 255 255 / .94); box-shadow:0 18px 46px rgb(16 24 32 / .14); backdrop-filter:blur(18px); z-index:200; }
  :root[data-theme="dark"] .dropdown { border-color:rgb(52 67 77 / .9); background:rgb(24 35 43 / .96); box-shadow:0 18px 46px rgb(0 0 0 / .28); }
  .dropdown-user { display:flex; align-items:center; gap:9px; padding:10px 12px; color:var(--color-text-muted); font:700 .76rem var(--font-ui); letter-spacing:.03em; border-bottom:1px solid rgb(216 222 227 / .72); }
  :root[data-theme="dark"] .dropdown-user { border-color:rgb(52 67 77 / .82); }
  .dropdown-avatar { width:24px; height:24px; border:1px solid rgb(255 255 255 / .9); border-radius:50%; object-fit:cover; background:linear-gradient(135deg,var(--color-signal),#7dd3fc); box-shadow:0 0 0 1px rgb(228 155 82 / .2); }
  .dropdown-item { display:flex; align-items:center; gap:9px; width:100%; min-height:38px; padding:9px 12px; border:0; background:transparent; color:var(--color-text); text-align:left; font:600 var(--text-xs) var(--font-ui); cursor:pointer; box-sizing:border-box; transition:background-color var(--motion-fast) var(--ease-standard),color var(--motion-fast) var(--ease-standard),padding-left var(--motion-fast) var(--ease-standard); }
  .dropdown-item:hover { background:rgb(228 155 82 / .1); color:var(--color-ink); padding-left:15px; }
  :root[data-theme="dark"] .dropdown-item:hover { background:rgb(228 155 82 / .14); color:var(--color-text); }
  .dropdown-icon { display:inline-flex; align-items:center; justify-content:center; width:18px; height:18px; flex:0 0 18px; border-radius:6px; background:rgb(228 155 82 / .12); color:var(--color-signal); font-size:.8rem; line-height:1; }
  .admin-link { color:var(--color-signal); font-weight:800; text-decoration:none; }
  .logout-item { border-top:1px solid rgb(216 222 227 / .72); color:var(--color-text-muted); }
  :root[data-theme="dark"] .logout-item { border-color:rgb(52 67 77 / .82); }
  .hidden-input { display:none; }
  .login-trigger { display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; padding:0; flex:0 0 34px; box-sizing:border-box; border:1px solid transparent; border-radius:50%; background:transparent; color:var(--color-text-muted); cursor:pointer; line-height:1; transition:border-color var(--motion-fast) var(--ease-standard),background-color var(--motion-base) var(--ease-standard),color var(--motion-fast) var(--ease-standard),box-shadow var(--motion-base) var(--ease-emphasis),transform var(--motion-base) var(--ease-emphasis); } .login-trigger:hover { border-color:var(--color-fog); background:var(--color-surface); color:var(--color-signal); box-shadow:0 8px 18px rgb(228 155 82 / .14); transform:translateY(-1px) scale(1.03); } .login-trigger:active { transform:translateY(0) scale(.96); } .login-trigger svg { width:16px; height:16px; }
  .hidden { display:none !important; }

  /* ---- 搜索触发按钮（触发按钮在 actions，弹窗由 SearchDialog 岛经 Teleport 渲染） ---- */
  .search-trigger { display:flex; align-items:center; justify-content:center; width:34px; height:34px; padding:0; flex:0 0 34px; box-sizing:border-box; border:1px solid transparent; border-radius:10px; background:transparent; color:var(--color-text-muted); cursor:pointer; line-height:1; transition:border-color var(--motion-fast) var(--ease-standard),background-color var(--motion-base) var(--ease-standard),color var(--motion-fast) var(--ease-standard),box-shadow var(--motion-base) var(--ease-emphasis),transform var(--motion-base) var(--ease-emphasis); }
  .search-trigger:hover { border-color:var(--color-fog); background:var(--color-surface); color:var(--color-signal); box-shadow:0 8px 18px rgb(228 155 82 / .14); transform:translateY(-1px) scale(1.03); }
  .search-trigger:active { transform:translateY(0) scale(.96); }
  .search-trigger svg { width:17px; height:17px; }

  /* ---- 移动端抽屉导航 ---- */
  .menu-toggle { display:none; flex-direction:column; justify-content:center; align-items:center; gap:4px; width:34px; height:34px; padding:0; flex:0 0 34px; border:1px solid transparent; border-radius:10px; background:transparent; cursor:pointer; }
  .menu-toggle span { display:block; width:16px; height:1.5px; border-radius:2px; background:var(--color-text); transition:transform var(--motion-base) var(--ease-emphasis),opacity var(--motion-base); }
  .menu-toggle[aria-expanded="true"] span:nth-child(1) { transform:translateY(5.5px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity:0; }
  .menu-toggle[aria-expanded="true"] span:nth-child(3) { transform:translateY(-5.5px) rotate(-45deg); }

  .drawer-overlay { position:fixed; inset:0; z-index:250; background:rgb(16 24 32 / .4); backdrop-filter:blur(2px); opacity:0; transition:opacity var(--motion-base) var(--ease-standard); }
  .mobile-drawer { position:fixed; top:0; right:0; bottom:0; z-index:260; width:min(320px,86vw); transform:translateX(100%); transition:transform var(--motion-base) var(--ease-emphasis); background:var(--color-surface); box-shadow:var(--shadow-float); display:flex; flex-direction:column; }
  .mobile-drawer.is-open { transform:none; }
  .drawer-head { display:flex; align-items:center; justify-content:space-between; padding:18px 20px; border-bottom:1px solid var(--color-fog); }
  .drawer-title { font:700 .9rem var(--font-ui); letter-spacing:.06em; color:var(--color-text); }
  .drawer-close { width:30px; height:30px; display:flex; align-items:center; justify-content:center; border:1px solid var(--color-fog); border-radius:8px; background:transparent; color:var(--color-text-muted); cursor:pointer; font-size:.9rem; }
  .drawer-close:hover { color:var(--color-signal); border-color:var(--color-signal); }
  .drawer-list { list-style:none; margin:0; padding:10px; display:flex; flex-direction:column; gap:2px; }
  .drawer-list li { margin:0; }
  .drawer-link { display:block; padding:13px 14px; border-radius:10px; color:var(--color-text); font:600 1rem var(--font-ui); text-decoration:none; transition:background var(--motion-fast),color var(--motion-fast),transform var(--motion-fast) var(--ease-standard); }
  .drawer-link:hover { background:var(--color-signal-soft); color:var(--color-ink); }
  .drawer-link:active { transform:scale(.985); }
  .drawer-link.nav-item-active { background:var(--color-signal); color:#fff; }
  .mobile-drawer.is-open .drawer-link { animation:drawer-item-in 420ms var(--ease-emphasis) both; animation-delay:calc(70ms + var(--i, 0) * 45ms); }
  @keyframes drawer-item-in { from { opacity:0; transform:translateX(16px); } to { opacity:1; transform:none; } }

  @media (max-width:680px) { .header-inner { min-height:62px; gap:12px; } .nav { display:none; } .logo { margin-right:auto; } .header-actions { padding:3px; border-radius:14px; } .dropdown { right:-40px; } .menu-toggle { display:flex; } }
</style>

<script>
import { applyOAuthResult, clearSession, getToken, getUser } from '@/lib/auth';

(function () {
  function isLoggedIn() {
    return !!getToken();
  }

  function generateAvatar(seed: string) {
    var h = 5381;
    for (var i = 0; i < (seed || '').length; i++) {
      h = ((h << 5) + h + seed.charCodeAt(i)) | 0;
    }
    h = Math.abs(h);
    var COLORS = ['#667eea','#f093fb','#4facfe','#43e97b','#fa709a','#30cfd0','#a8edea','#ff9a9e','#ffecd2','#ff6a00'];
    var c = COLORS[h % COLORS.length];
    return 'data:image/svg+xml,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 7 7"><rect width="7" height="7" fill="' + c + '"/><text x="3.5" y="5.2" text-anchor="middle" fill="var(--color-on-ink)" font-size="4.5" font-family="sans-serif">' + (seed || '?')[0].toUpperCase() + '</text></svg>'
    );
  }

  function initAuth() {
    var userArea = document.getElementById('auth-user-area');
    var loginBtn = document.getElementById('auth-login-btn');
    var userMenu = document.getElementById('auth-user-menu');
    var userAvatar = document.getElementById('auth-user-avatar') as HTMLImageElement | null;
    var dropdownAvatar = document.getElementById('auth-dropdown-avatar') as HTMLImageElement | null;
    var dropdownName = document.getElementById('auth-dropdown-name');
    var userDropdown = document.getElementById('auth-user-dropdown');
    var adminLink = document.getElementById('auth-admin-link');
    var logoutBtn = document.getElementById('auth-logout-btn');
    var avatarPickBtn = document.getElementById('auth-avatar-pick-btn') as HTMLElement | null;

    if (!userArea || !loginBtn) return;

    if (isLoggedIn()) {
      var user = getUser();
      var src = (user && user.avatar) || generateAvatar((user && user.username) || 'u');
      // 始终同步头像 src（相同值不会触发重载；换头像/上传后广播事件即时生效）
      if (userAvatar && userAvatar.getAttribute('src') !== src) userAvatar.src = src;
      if (dropdownAvatar && dropdownAvatar.getAttribute('src') !== src) dropdownAvatar.src = src;
      if (dropdownName && user) dropdownName.textContent = user.nickname || user.username || '用户';
      userArea.classList.remove('hidden');
      loginBtn.classList.add('hidden');
      // 管理员显示后台入口
      if (user && user.role === 'admin' && adminLink) {
        adminLink.classList.remove('hidden');
      }
    } else {
      userArea.classList.add('hidden');
      loginBtn.classList.remove('hidden');
    }

    // 点击头像展开下拉；点击外部/Escape 关闭
    if (userMenu && userDropdown) {
      userMenu.onclick = function (e) {
        e.stopPropagation();
        userDropdown?.classList.toggle('hidden');
      };
      userMenu.onkeydown = function (e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        userDropdown?.classList.toggle('hidden');
      };
      document.addEventListener('click', function () {
        userDropdown?.classList.add('hidden');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') userDropdown?.classList.add('hidden');
      });
    }

    // 退出登录
    if (logoutBtn) {
      logoutBtn.onclick = function () {
        clearSession();
        location.reload();
      };
    }

    // 更换头像：打开预设头像选择面板（Vue 岛 AvatarPicker）
    if (avatarPickBtn) {
      avatarPickBtn.onclick = function (e) {
        e.stopPropagation();
        userDropdown?.classList.add('hidden');
        document.dispatchEvent(new CustomEvent('open-avatar-picker'));
      };
    }

    // 登录按钮 → 触发 LoginDialog
    loginBtn.onclick = function () {
      document.dispatchEvent(new CustomEvent('open-login'));
    };
  }

  // 更新导航激活状态（View Transitions下 Header 不会重新渲染）
  function updateNavActive() {
    var pathname = window.location.pathname;
    var current = pathname.replace(/\/$/, '') || '/';
    var navLinks = document.querySelectorAll('.nav-link.nav-item, .drawer-link.nav-item');
    navLinks.forEach(function (link) {
      var href = link.getAttribute('href') || '';
      var normalizedHref = href.replace(/\/$/, '') || '/';
      var isActive = false;
      if (normalizedHref === '/') {
        isActive = current === '/' || current.startsWith('/blog/') || current.startsWith('/category/') || current.startsWith('/tag/') || current.startsWith('/archives/');
      } else {
        isActive = current === normalizedHref || current.startsWith(href);
      }
      link.classList.toggle('nav-item-active', isActive);
    });
  }

  initAuth();
  updateNavActive();

  // OAuth 回调：URL 带 oauth_token 时写会话 + 刷新头像区域
  applyOAuthResult().then(function (handled) {
    if (handled) initAuth();
  });

  // 跨标签页同步：其他标签页登录/登出/换头像时本页实时跟随
  window.addEventListener('storage', function () {
    initAuth();
  });

  // 401 触发：apiRequest 已清空本地会话，这里同步刷新 UI
  document.addEventListener('blog-auth-expired', function () {
    initAuth();
  });

  // 登录/注册/换头像成功：立即刷新头像区域，无需等待导航
  window.addEventListener('blog-auth-change', function () {
    initAuth();
  });

  document.addEventListener('astro:page-load', function () {
    initAuth();
    updateNavActive();
  });
})();
</script>
