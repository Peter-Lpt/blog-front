---
export interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string; // 如 '/' 或 '/category/前端/'
}

const { currentPage, totalPages, baseUrl } = Astro.props;

function pageHref(page: number): string {
  if (page === 1) return baseUrl;
  // 首页分页：/page/2/；其他：原 baseUrl 已带斜杠，拼数字
  if (baseUrl === '/') return `/page/${page}/`;
  return `${baseUrl}page/${page}/`;
}

const showPrev = currentPage > 1;
const showNext = currentPage < totalPages;

// 页码折叠：首尾 + 当前 ±1，中间用省略号
function pageItems(current: number, total: number): Array<number | '…'> {
  const items: Array<number | '…'> = [];
  if (total <= 7) {
    for (let i = 1; i <= total; i++) items.push(i);
    return items;
  }
  const set = new Set<number>([1, total, current - 1, current, current + 1]);
  const sorted = [...set].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
  let prev = 0;
  sorted.forEach((n) => {
    if (prev && n - prev > 1) items.push('…');
    items.push(n);
    prev = n;
  });
  return items;
}

const pages = pageItems(currentPage, totalPages);
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="分页">
    {showPrev && <a href={pageHref(currentPage - 1)} rel="prev">← 上一页</a>}
    <div class="page-numbers">
      {pages.map((p) => (
        p === '…'
          ? <span class="page-ellipsis" aria-hidden="true">…</span>
          : <a href={pageHref(p)} class:list={['page-num', { active: p === currentPage }]}>{p}</a>
      ))}
    </div>
    {showNext && <a href={pageHref(currentPage + 1)} rel="next">下一页 →</a>}
  </nav>
)}

<style>
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .pagination a {
    color: var(--color-text-muted);
    padding: 6px 12px;
    border-radius: 8px;
    transition: all 0.2s;
  }
  .pagination a:hover {
    color: var(--color-signal);
    background: var(--color-signal-soft);
  }
  .page-numbers {
    display: flex;
    gap: 4px;
  }
  .page-num {
    min-width: 32px;
    text-align: center;
  }
  .page-ellipsis {
    min-width: 24px;
    text-align: center;
    color: var(--color-text-faint);
  }
  .page-num.active {
    background: var(--color-signal);
    color: #fff;
  }
</style>
