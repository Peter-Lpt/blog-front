---
import { SITE } from '@/lib/config';
import { getMainCategories, getAllTags, getArchives, getArticleDatesByDay } from '@/lib/posts';
import CalendarArchive from '@/components/islands/CalendarArchive.vue';

interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  tocItems?: TocItem[];
  /** 详情页模式：只显示目录，不显示作者卡/分类/标签等 */
  minimal?: boolean;
}

const { tocItems = [], minimal = false } = Astro.props;

const [categories, tags, archives, articleDates] = await Promise.all([
  getMainCategories(),
  getAllTags(),
  getArchives(),
  getArticleDatesByDay(),
]);
---

<aside class:list={['sidebar', { minimal }]}>
  {!minimal && (
    <div class="sidebar-non-toc">
      <div class="author-card">
        <div class="author-avatar">
          <img src="/avatar.png" alt={SITE.author} onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="avatar-fallback" style="display:none">{SITE.author.charAt(0)}</div>
        </div>
        <h2 class="author-name">{SITE.author}</h2>
        <p class="author-desc">代码与生活的记录者</p>
        {SITE.github && (
          <a href={SITE.github} target="_blank" rel="noopener" class="github-link">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            <span>GitHub</span>
          </a>
        )}
      </div>

      {Object.keys(archives).length > 0 && (
        <CalendarArchive articleDates={articleDates} client:load />
      )}
    </div>
  )}

  {minimal && tocItems.length > 0 && (
    <details class="mobile-toc">
      <summary>文章目录 <span>{tocItems.length} 节</span></summary>
      <nav>
        {tocItems.map((item) => (
          <a href={'#' + item.slug} class={'toc-h' + item.depth}>{item.text}</a>
        ))}
      </nav>
    </details>
  )}

  {tocItems.length > 0 && (
    <section class="sidebar-section toc-section">
      <h3 class="sidebar-title">目录</h3>
      <nav class="toc-nav">
        {tocItems.map((item) => (
          <a
            href={'#' + item.slug}
            class={'toc-item toc-h' + item.depth}
            data-toc-target={item.slug}
          >
            {item.text}
          </a>
        ))}
      </nav>
    </section>
  )}

  {!minimal && Object.keys(categories).length > 0 && (
    <section class="sidebar-section">
      <h3 class="sidebar-title">分类</h3>
      <ul class="category-list">
        {Object.entries(categories).map(([name, count]) => (
          <li>
            <a href={`/category/${name}/`}>
              <span>{name}</span>
              <span class="count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {!minimal && Object.keys(tags).length > 0 && (
    <section class="sidebar-section">
      <h3 class="sidebar-title">标签</h3>
      <div class="tag-cloud">
        {Object.entries(tags).map(([name, count]) => (
          <a href={`/tag/${name}/`} class="tag-chip">{name}<span class="tag-count">{count}</span></a>
        ))}
      </div>
    </section>
  )}
</aside>

<style>
  .sidebar { width:240px; flex-shrink:0; position:sticky; top:96px; height:fit-content; display:flex; flex-direction:column; gap:18px; }
  .sidebar.minimal { width:210px; top:110px; }
  .sidebar.minimal .sidebar-section { position:relative; overflow:hidden; padding:20px 18px; border:1px solid var(--color-fog); border-radius:20px; background:var(--color-surface); box-shadow:var(--shadow-soft); }
  .sidebar.minimal .sidebar-section::before { content:''; position:absolute; inset:0 0 auto; height:3px; background:linear-gradient(90deg,var(--color-signal),transparent 76%); }
  .sidebar.minimal .sidebar-title { color:var(--color-text); }
  .sidebar.minimal .toc-nav { border-left-color:var(--color-fog); }
  .sidebar.minimal .toc-item { color:var(--color-text-muted); }
  .sidebar.minimal .toc-item:hover,.sidebar.minimal .toc-item.toc-active { color:var(--color-signal); border-left-color:var(--color-signal); }
  .sidebar-non-toc { display:flex; flex-direction:column; gap:18px; }
  .author-card,.sidebar-section,.calendar-archive { background:rgb(255 255 255 / .52); border:1px solid var(--color-fog); border-radius:var(--radius-md); padding:18px; }
  :root[data-theme="dark"] .author-card,:root[data-theme="dark"] .sidebar-section,:root[data-theme="dark"] .calendar-archive { background:rgb(24 35 43 / .55); }
  .author-card { text-align:left; }
  .author-avatar { width:54px; height:54px; margin:0 0 16px; border-radius:18px; overflow:hidden; border:2px solid var(--color-signal); box-shadow:0 8px 22px rgb(16 24 32 / .12); }
  .author-avatar img { width:100%; height:100%; object-fit:cover; } .avatar-fallback { width:100%; height:100%; align-items:center; justify-content:center; background:var(--color-signal); color:#fff; font:700 24px var(--font-ui); }
  .author-name { margin:0 0 4px; color:var(--color-text); font:600 1.05rem var(--font-display); } .author-desc { margin:0 0 14px; color:var(--color-text-muted); font-size:var(--text-xs); }
  .github-link { display:inline-flex; align-items:center; gap:6px; color:var(--color-text-muted); font:600 var(--text-xs) var(--font-ui); } .github-link:hover { color:var(--color-signal); }
  .sidebar-title { display:flex; align-items:center; gap:8px; margin:0 0 14px; color:var(--color-text); font:600 var(--text-xs) var(--font-ui); letter-spacing:.12em; text-transform:uppercase; } .sidebar-title::before { content:''; width:16px; height:2px; background:var(--color-signal); }
  .toc-nav { display:flex; flex-direction:column; gap:5px; border-left:1px solid var(--color-fog); } .toc-item { padding:4px 0 4px 12px; color:var(--color-text-muted); font-size:var(--text-xs); line-height:1.45; border-left:2px solid transparent; margin-left:-1px; } .toc-item:hover,.toc-item.toc-active { color:var(--color-signal); border-left-color:var(--color-signal); } .toc-h3 { padding-left:24px; }
  .category-list { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px; } .category-list li a { display:flex; justify-content:space-between; color:var(--color-text-muted); font-size:var(--text-sm); } .category-list li a:hover { color:var(--color-signal); } .count,.tag-count { color:var(--color-text-faint); font:var(--text-xs) var(--font-ui); }
  .tag-cloud { display:flex; flex-wrap:wrap; gap:6px; } .tag-chip { padding:4px 8px; border:1px solid var(--color-fog); border-radius:999px; color:var(--color-text-muted); font-size:var(--text-xs); } .tag-chip:hover { border-color:var(--color-signal); color:var(--color-signal); background:var(--color-signal-soft); } .tag-count { margin-left:4px; }
  @media (max-width:980px) { .sidebar,.sidebar.minimal { width:180px; } }
  .mobile-toc { display:none; }
  @media (max-width:680px) { .sidebar { position:static; width:100%; display:grid; grid-template-columns:1fr 1fr; gap:12px; } .sidebar-non-toc { display:contents; } .author-card { grid-column:1/-1; } .sidebar.minimal { display:block; width:100%; } .sidebar.minimal .toc-section { display:none; } .mobile-toc { display:block; border:1px solid var(--color-fog); border-radius:var(--radius-md); background:var(--color-surface); } .mobile-toc summary { display:flex; justify-content:space-between; padding:14px 16px; color:var(--color-text); font:600 var(--text-sm) var(--font-ui); cursor:pointer; list-style:none; } .mobile-toc summary::-webkit-details-marker { display:none; } .mobile-toc summary span { color:var(--color-text-faint); font-weight:400; } .mobile-toc nav { display:flex; flex-direction:column; gap:8px; padding:0 16px 16px; border-top:1px solid var(--color-fog); } .mobile-toc nav a { padding-top:10px; color:var(--color-text-muted); font-size:var(--text-sm); } .mobile-toc nav .toc-h3 { padding-left:14px; } .toc-section { grid-column:1/-1; } .sidebar-section:not(.toc-section) { min-width:0; } }
</style>
