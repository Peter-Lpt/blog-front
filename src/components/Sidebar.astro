---
import { getMainCategories, getAllTags, getArchives, formatDate } from '@/lib/posts';

const [categories, tags, archives] = await Promise.all([
  getMainCategories(),
  getAllTags(),
  getArchives(),
]);
---

<aside class="sidebar">
  <section class="sidebar-section">
    <h3 class="sidebar-title">分类</h3>
    <ul class="category-list">
      {Object.entries(categories).map(([name, count]) => (
        <li>
          <a href={`/category/${name}/`}>
            <span>{name}</span>
            <span class="count">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {Object.keys(tags).length > 0 && (
    <section class="sidebar-section">
      <h3 class="sidebar-title">标签</h3>
      <div class="tag-cloud">
        {Object.entries(tags).map(([name, count]) => (
          <a href={`/tag/${name}/`} class="tag-chip">#{name}<span class="tag-count">{count}</span></a>
        ))}
      </div>
    </section>
  )}

  {Object.keys(archives).length > 0 && (
    <section class="sidebar-section">
      <h3 class="sidebar-title">归档</h3>
      <ul class="archive-list">
        {Object.entries(archives).map(([key, posts]) => (
          <li>
            <a href={`/archives/${key}/`}>
              <span>{key}</span>
              <span class="count">{posts.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</aside>

<style>
  .sidebar {
    width: 280px;
    flex-shrink: 0;
    position: sticky;
    top: 96px;
    height: fit-content;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .sidebar-section {
    background: var(--card-bg);
    border: var(--card-border);
    border-radius: var(--card-radius);
    padding: 18px 20px;
  }
  .sidebar-title {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-color);
  }
  .category-list, .archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .category-list a, .archive-list a {
    display: flex;
    justify-content: space-between;
    color: var(--text-secondary);
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 14px;
    transition: all 0.2s;
  }
  .category-list a:hover, .archive-list a:hover {
    color: var(--primary-color);
    background: var(--primary-color-light);
  }
  .count {
    color: var(--text-secondary);
    font-size: 12px;
  }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 12px;
    background: var(--glass-bg);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 12px;
    transition: all 0.2s;
  }
  .tag-chip:hover {
    color: var(--primary-color);
    border-color: var(--primary-color);
  }
  .tag-count {
    font-size: 11px;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .sidebar {
      width: 100%;
      position: static;
    }
  }
</style>
