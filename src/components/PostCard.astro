---
import { CATEGORY_COLORS, DEFAULT_GRADIENT } from '@/lib/config';
import { formatDate, getSlug, type Post } from '@/lib/posts';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const slug = getSlug(post);
const { title, pubDate, tags, description, coverImage } = post.data;
const category = tags?.[0] || '';
const [c1, c2] = CATEGORY_COLORS[category] || DEFAULT_GRADIENT;
const url = `/blog/${slug}/`;
---

<article class="post-card">
  <a href={url} class="card-link" aria-label={title}>
    {coverImage ? (
      <div class="cover">
        <img src={coverImage} alt={title} loading="lazy" decoding="async" />
      </div>
    ) : (
      <div class="cover cover-gradient" style={`background: linear-gradient(135deg, ${c1}, ${c2})`}>
        <span class="cover-title">{title}</span>
      </div>
    )}
    <div class="card-body">
      <h2 class="card-title">{title}</h2>
      {description && <p class="card-desc">{description}</p>}
      <div class="card-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {tags && tags.length > 0 && (
          <div class="card-tags">
            {tags.slice(0, 3).map((t) => (
              <span class="tag">#{t}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    background: var(--card-bg);
    border: var(--card-border);
    border-radius: var(--card-radius);
    overflow: hidden;
    transition: all 0.3s ease;
  }
  .post-card:hover {
    box-shadow: var(--card-hover-shadow);
    border-color: var(--primary-color);
    transform: translateY(-2px);
  }
  .card-link {
    display: block;
    color: inherit;
  }
  .cover {
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .post-card:hover .cover img {
    transform: scale(1.03);
  }
  .cover-gradient {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .cover-title {
    color: #fff;
    font-size: 18px;
    font-weight: 600;
    text-align: center;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-body {
    padding: 18px 20px;
  }
  .card-title {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.4;
    color: var(--text-color);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-desc {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0 0 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .card-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .tag {
    color: var(--primary-color);
  }
</style>
