---
import { SITE } from '@/lib/config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-mark" aria-hidden="true"></span>
      <span class="footer-word">{SITE.title}</span>
      <span class="footer-sep" aria-hidden="true">·</span>
      <p class="footer-copy">© {year} 保留所有权利</p>
    </div>
    <nav class="footer-nav" aria-label="页脚导航">
      <a href="/archives/" class="text-link">归档 <span class="arr" aria-hidden="true">→</span></a>
      <a href="/tools/" class="text-link">工具箱 <span class="arr" aria-hidden="true">→</span></a>
      <a href="/rss.xml" class="text-link">RSS <span class="arr" aria-hidden="true">→</span></a>
      {SITE.github && <a href={SITE.github} target="_blank" rel="noopener" class="text-link">GitHub <span class="arr" aria-hidden="true">↗</span></a>}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-fog);
    padding: 26px 0;
    margin-top: auto;
    background: var(--glass-bg);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  .footer-brand { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .footer-mark { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 50%; background: var(--color-signal); box-shadow: 0 0 0 4px var(--color-signal-soft); }
  .footer-word { color: var(--color-text); font: 700 .82rem var(--font-display); letter-spacing: .02em; white-space: nowrap; }
  .footer-sep { color: var(--color-fog-strong); }
  .footer-copy { margin: 0; color: var(--color-text-faint); font-size: var(--text-xs); }
  .footer-nav { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 18px; }
  @media (max-width: 640px) {
    .footer-inner { flex-direction: column; align-items: flex-start; gap: 12px; }
    .site-footer { padding: 22px 0; }
  }
</style>
